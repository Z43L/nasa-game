# src/mis_g3.lg: misiones del grupo 3 (47 a 66): energía y batería. Ver src/mision_modelo.lg.
import mision_modelo

fn mis_g3() -> List[MisionDato]:
    mut l: List[MisionDato] = []
    # Fáciles
    l.append(mis_dato(47, 200, 1, "dif.facil", "tipo.comando",
        [mis_av("energia", "av.g3.cableado", -1, 40)],
        [mis_cond("energia", 1, 0, 0), mis_cond("energia", 0, 0, 45)]))
    l.append(mis_dato(48, 200, 1, "dif.facil", "tipo.comando",
