        [mis_cond("reactor", 1, 0, 0), mis_cond("energia", 1, 0, 0), mis_cond("comunicaciones", 1, 0, 0), mis_cond("oxigeno", 1, 0, 0), mis_cond("energia", 0, 0, 40), mis_cond("comunicaciones", 0, 0, 85)]))
