# src/mis_g4.lg: misiones 67 a 86 (grupo 4: comunicaciones y trayectoria). Ver src/mision_modelo.lg.
import mision_modelo

fn mis_g4() -> List[MisionDato]:
    mut l: List[MisionDato] = []
    # Facil
    l.append(mis_dato(67, 200, 1, "dif.facil", "tipo.comando",
