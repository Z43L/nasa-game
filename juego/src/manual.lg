# src/manual.lg: páginas de manual del juego, traducidas (traducciones.json).
#   manual_comando(id) -> str   páginas de `man` (id interno de la orden)
#   manual_codigo(tema) -> str  páginas de `man-code` (lenguaje y API de scripts)
#   manual_comandos() -> str    lista de órdenes con `man`
#   manual_temas() -> str       lista de temas con `man-code`

import i18n
import texto

fn manual_ordenes() -> List[str]:
    return ["ayuda", "man", "man-code", "estado", "valor", "diagnostico", "reparar", "encender", "apagar", "ajustar", "mision", "misiones", "iniciar", "esperar", "ls", "cat", "editar", "ejecutar", "echo", "pwd", "limpiar", "idioma"]

fn manual_temas_ids() -> List[str]:
    return ["sintaxis", "variables", "condiciones", "bucles", "funciones", "listas", "diccionarios", "structs", "cadenas", "nave", "scripts"]

fn manual_comandos() -> str:
    mut nombres: List[str] = []
    ordenes = manual_ordenes()
    for i in 0..len(ordenes):
        nombres.append(tr("cmd." + ordenes[i]))
    return trc("man.comandos", [texto_unir(nombres, "  ")])

fn manual_temas() -> str:
    return tr("man.temas")

fn manual_comando(id: str) -> str:
    mut clave = id
    if id == "sensores":
        clave = "estado"
    m = tr("man." + clave)
    if m == "[man." + clave + "]":
        return trc("man.no_hay", [id])
    return m

fn manual_codigo(tema: str) -> str:
    if tema == "":
        return manual_temas()
    id = i18n_canonico("tema.", manual_temas_ids(), tema)
    m = tr("code." + id)
    if m == "[code." + id + "]":
        return trc("code.no_hay", [tema])
    return m
