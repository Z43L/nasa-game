# src/mis_g2.lg: misiones del grupo 2 (27 a 46): gases y atmósfera. Ver src/mision_modelo.lg.
import mision_modelo

fn mis_g2() -> List[MisionDato]:
    mut l: List[MisionDato] = []
    l.append(mis_dato(27, 200, 1, "dif.facil", "tipo.comando",
