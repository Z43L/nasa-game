# src/partidas.lg: tres ranuras de partida por usuario: usuarios/<nombre>/ranura_N.json
#   partida_guardar(n) -> str    "" si va bien
#   partida_cargar(n) -> str     "" si va bien
#   partida_resumen(n) -> str    "" si la ranura está libre (o no hay sesión)
#   partida_ranuras() -> int     3

import archivo
import json
import sesion
import usuarios
import misiones
import i18n
import estado

fn partida_ranuras() -> int:
    return 3

fn partida_valida(n: int) -> bool:
    return n >= 1 and n <= partida_ranuras()

fn partida_fichero(n: int) -> str:
    return usuario_carpeta(sesion_actual()) + "/ranura_" + str(n) + ".json"

fn partida_resumen_actual() -> str:
    if mision_estado_actual() == 0:
        return tr("part.sin_mision")
    mut estado_txt = tr("part.estado.curso")
    if mision_estado_actual() == 2:
        estado_txt = tr("part.estado.completada")
    if mision_estado_actual() == 3:
        estado_txt = tr("part.estado.fallida")
    return trc("part.resumen_mision", [str(mision_numero()), estado_txt])

fn partida_guardar(n: int) -> str:
    if not partida_valida(n) or sesion_actual() == "":
        return tr("part.error_ranura")
    claves: List[str] = ["estado", "resumen"]
    valores: List[JsonValor] = [json_nuevo_cadena(estado_serializar_con(false)), json_nuevo_cadena(partida_resumen_actual())]
    if not usuario_escribir(partida_fichero(n), json_serializar(json_nuevo_objeto(claves, valores))):
        return tr("part.error_escribir")
    return ""

fn partida_cargar(n: int) -> str:
    if not partida_valida(n) or sesion_actual() == "":
        return tr("part.error_ranura")
    if not archivo_existe(partida_fichero(n)):
        return tr("part.vacia")
    raiz = json_parsear(archivo_leer_todo(partida_fichero(n)))
    if json_es_error(raiz):
        return tr("part.error_formato")
    if estado_cargar(json_texto(json_obtener(raiz, "estado"))) != "":
        return tr("part.error_formato")
    return ""

fn partida_resumen(n: int) -> str:
    if not partida_valida(n) or sesion_actual() == "" or not archivo_existe(partida_fichero(n)):
        return ""
    raiz = json_parsear(archivo_leer_todo(partida_fichero(n)))
    if json_es_error(raiz):
        return ""
    return json_texto(json_obtener(raiz, "resumen"))
