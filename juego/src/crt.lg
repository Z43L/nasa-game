# src/crt.lg: estética CRT (terminal de fósforo verde) de toda la interfaz. Sin JavaScript:
# los menús son enlaces <a href> y los formularios usan enctype="text/plain".
#
#   crt_css() -> str                                 bloque <style> completo
#   crt_pagina(titulo: str, cuerpo: Nodo) -> str     página completa (cabecera, scanlines, pie)
#   crt_cambiar_tema(nombre: str) -> bool            green, amber, cyan, white
#   crt_tema_actual() -> str
#   crt_alternar_scanlines()
#   crt_scanlines_activas() -> bool
#   crt_titulo(rotulo: str) -> Nodo                  h2 con "// rotulo"
#   crt_volver(href: str, etiqueta: str) -> Nodo     enlace de vuelta
#   crt_opcion(numero: int, etiqueta: str, sub: str, href: str, activa: bool) -> Nodo   li > a
#   crt_menu(opciones: List[Nodo]) -> Nodo           nav con la lista de opciones
#   crt_arranque(lineas: List[str], href_continuar: str) -> Nodo
#   crt_fila_config(etiqueta: str, valor: str, href: str) -> Nodo
#   crt_ajustes() -> Nodo                            pantalla de ajustes (tema y scanlines)
#   crt_creditos() -> Nodo
#   crt_banner() -> Nodo                             título ASCII del juego

import html
import render
import texto
import i18n

mut crt_tema = "green"
mut crt_scan = true

# ---------- tema y scanlines ----------

fn crt_temas() -> List[str]:
    return ["green", "amber", "cyan", "white"]

fn crt_cambiar_tema(nombre: str) -> bool:
    temas = crt_temas()
    for i in 0..len(temas):
        if temas[i] == nombre:
            crt_tema = nombre
            return true
    return false

fn crt_tema_actual() -> str:
    return crt_tema

# Siguiente tema en el ciclo green -> amber -> cyan -> white -> green.
fn crt_tema_siguiente() -> str:
    temas = crt_temas()
    for i in 0..len(temas):
        if temas[i] == crt_tema:
            if i + 1 == len(temas):
                return temas[0]
            return temas[i + 1]
    return "green"

fn crt_alternar_scanlines():
    crt_scan = not crt_scan

fn crt_scanlines_activas() -> bool:
    return crt_scan

# ---------- hoja de estilos ----------

fn crt_css() -> str:
    reglas = [
        # Tokens de color. El tema se elige con data-theme en <html>.
        ":root, [data-theme='green'] { --phosphor-color: #00ff66; --phosphor-rgb: 0, 255, 102; --phosphor-dim: #003311; --phosphor-glow: rgba(0, 255, 102, 0.4); --bg-color: #050a05; --scanline-color: rgba(0, 0, 0, 0.3); --border-color: #00ff66; --alerta: #ff4d4d; --aviso: #ffb000; --filtro-mono: grayscale(1) sepia(1) saturate(5) hue-rotate(70deg); --font-primary: 'Share Tech Mono', monospace; --font-heading: 'VT323', monospace; }",
        "[data-theme='amber'] { --phosphor-color: #ffb000; --phosphor-rgb: 255, 176, 0; --phosphor-dim: #332200; --phosphor-glow: rgba(255, 176, 0, 0.4); --bg-color: #0a0700; --border-color: #ffb000; --aviso: #fff0a0; --filtro-mono: grayscale(1) sepia(1) saturate(3) brightness(1.1); }",
        "[data-theme='cyan'] { --phosphor-color: #00ffff; --phosphor-rgb: 0, 255, 255; --phosphor-dim: #003333; --phosphor-glow: rgba(0, 255, 255, 0.4); --bg-color: #000a0a; --border-color: #00ffff; --aviso: #ffe066; --filtro-mono: grayscale(1) sepia(1) saturate(5) hue-rotate(150deg); }",
        "[data-theme='white'] { --phosphor-color: #ffffff; --phosphor-rgb: 255, 255, 255; --phosphor-dim: #333333; --phosphor-glow: rgba(255, 255, 255, 0.4); --bg-color: #080808; --border-color: #ffffff; --aviso: #ffe066; --filtro-mono: grayscale(1); }",
        # Base
        "* { box-sizing: border-box; margin: 0; padding: 0; }",
        "html, body { height: 100%; }",
        "body { background-color: var(--bg-color); color: var(--phosphor-color); font-family: var(--font-primary); height: 100vh; width: 100vw; overflow: hidden; display: flex; justify-content: center; align-items: center; transition: color 0.3s ease, background-color 0.3s ease; }",
        "a { color: inherit; }",
        "button, input, select, textarea { font: inherit; color: inherit; }",
        "::selection { background: var(--phosphor-color); color: var(--bg-color); }",
        "h1, h2, h3, h4 { font-weight: normal; }",
        "h2 { font-family: var(--font-heading); font-size: 1.8rem; margin-bottom: 25px; border-bottom: 1px dashed var(--border-color); padding-bottom: 5px; text-shadow: 0 0 8px var(--phosphor-glow); }",
        "h3 { font-family: var(--font-heading); font-size: 1.4rem; }",
        "h4 { font-size: 0.9rem; opacity: 0.7; margin-bottom: 5px; text-transform: uppercase; letter-spacing: 1px; }",
        "p { line-height: 1.5; }",
        "strong { font-weight: normal; text-shadow: 0 0 6px var(--phosphor-glow); }",
        # Capa CRT: scanlines y parpadeo
        ".crt-raiz { display: flex; justify-content: center; align-items: center; width: 100vw; height: 100vh; }",
        ".crt-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 999; }",
        ".crt-overlay.off { display: none; }",
        ".scanline { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, var(--scanline-color) 50%, var(--scanline-color)); background-size: 100% 4px; z-index: 1000; }",
        ".flicker { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(18, 16, 16, 0.05); opacity: 0.8; z-index: 1001; animation: crt-flicker 0.15s infinite; }",
        "@keyframes crt-flicker { 0% { opacity: 0.97; } 50% { opacity: 1; } 100% { opacity: 0.96; } }",
        "@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }",
        ".blink, .blink-dot { animation: blink 1s infinite; }",
        # Contenedor, cabecera y pie
        ".terminal-container { width: 95vw; max-width: 1100px; height: 90vh; max-height: 750px; border: 2px solid var(--border-color); box-shadow: 0 0 20px var(--phosphor-glow), inset 0 0 15px var(--phosphor-glow); background-color: var(--bg-color); display: flex; flex-direction: column; position: relative; overflow: hidden; border-radius: 4px; }",
        ".terminal-header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px; padding: 8px 15px; border-bottom: 1px dashed var(--border-color); font-size: 0.9rem; background-color: var(--phosphor-dim); flex: none; }",
        ".status-left, .status-right { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; }",
        ".divider { margin: 0 6px; opacity: 0.5; }",
        ".terminal-header a { border: 1px solid var(--border-color); padding: 1px 6px; font-size: 0.8rem; text-decoration: none; transition: background 0.2s, color 0.2s; }",
        ".terminal-header a:hover, .terminal-header a.activo { background: var(--phosphor-color); color: var(--bg-color); }",
        ".reloj { font-variant-numeric: tabular-nums; }",
        ".terminal-body { flex: 1; min-height: 0; position: relative; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; }",
        ".terminal-body:has(> .escritorio-raiz) { padding: 0; overflow: hidden; }",
        ".terminal-footer { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 4px 12px; padding: 8px 15px; border-top: 1px dashed var(--border-color); font-size: 0.8rem; background-color: var(--phosphor-dim); flex: none; }",
        ".footer-help span { margin-right: 15px; opacity: 0.8; }",
        ".footer-version { opacity: 0.7; }",
        # Arranque
        ".boot-screen { font-size: 0.95rem; line-height: 1.4; }",
        ".boot-logs p { margin-bottom: 4px; text-shadow: 0 0 5px var(--phosphor-glow); }",
        ".boot-prompt { margin-top: 20px; font-weight: bold; text-shadow: 0 0 8px var(--phosphor-glow); }",
        ".boot-link { display: inline-block; border: 1px solid var(--border-color); padding: 4px 10px; text-decoration: none; animation: blink 1.2s infinite; }",
        ".boot-link:hover { background: var(--phosphor-color); color: var(--bg-color); }",
        # Banner y menú
        ".ascii-art-container { width: 100%; display: flex; justify-content: center; margin-bottom: 10px; }",
        ".ascii-banner { font-family: var(--font-heading); font-size: 1.1rem; line-height: 1.0; text-shadow: 0 0 8px var(--phosphor-glow); white-space: pre; color: var(--phosphor-color); max-width: 100%; overflow-x: auto; }",
        ".menu-announcement { text-align: center; font-size: 0.9rem; margin-bottom: 15px; opacity: 0.85; }",
        ".menu-options { width: 100%; max-width: 500px; margin: 0 auto; }",
        ".menu-options ul { list-style: none; }",
        ".menu-item { margin-bottom: 8px; border: 1px solid transparent; font-size: 1.2rem; font-family: var(--font-heading); letter-spacing: 1px; transition: all 0.1s ease; }",
        ".menu-item a { display: flex; align-items: center; width: 100%; padding: 10px 15px; text-decoration: none; color: inherit; }",
        ".menu-item:hover { border-color: var(--border-color); }",
        ".menu-item .pointer { opacity: 0; margin-right: 10px; font-weight: bold; }",
        ".menu-item .key { margin-right: 10px; opacity: 0.7; }",
        ".menu-item .sub-hint { margin-left: auto; font-size: 0.9rem; opacity: 0.6; }",
        ".menu-item.active { border: 1px dashed var(--border-color); background-color: var(--phosphor-dim); text-shadow: 0 0 8px var(--phosphor-glow); }",
        ".menu-item.active .pointer { opacity: 1; }",
        # Subpantallas, configuración, créditos, guardado
        ".sub-screen { flex: 1; min-height: 0; display: flex; flex-direction: column; padding: 10px 20px; }",
        ".config-options, .credits-content, .save-slots { flex: 1; max-width: 600px; }",
        ".config-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 20px; font-size: 1.2rem; }",
        ".config-btn { display: inline-block; background: var(--phosphor-dim); border: 1px solid var(--border-color); color: var(--phosphor-color); padding: 6px 15px; font-family: var(--font-primary); cursor: pointer; font-size: 1rem; text-decoration: none; transition: all 0.2s; }",
        ".config-btn:hover { background: var(--phosphor-color); color: var(--bg-color); }",
        "select.config-btn, select { background-color: var(--bg-color); color: var(--phosphor-color); font-family: var(--font-primary); border: 1px solid var(--border-color); padding: 4px 8px; }",
        "select option { background-color: var(--bg-color); color: var(--phosphor-color); }",
        ".save-slot { display: block; padding: 15px; border: 1px dashed var(--border-color); margin-bottom: 15px; background-color: var(--phosphor-dim); font-size: 1.1rem; text-decoration: none; cursor: pointer; transition: background 0.2s; }",
        ".save-slot:hover { background: var(--phosphor-color); color: var(--bg-color); }",
        ".save-slot.empty { opacity: 0.6; }",
        ".credits-content { font-size: 1.2rem; line-height: 1.6; }",
        ".blink-texto { animation: blink 1.2s infinite; }",
        ".back-hint { margin-top: auto; font-size: 0.9rem; text-align: center; padding-top: 20px; }",
        ".back-hint a, .volver { color: var(--phosphor-color); text-decoration: none; border-bottom: 1px dashed var(--border-color); }",
        ".back-hint a:hover, .volver:hover { background: var(--phosphor-color); color: var(--bg-color); }",
        # Misiones
        ".mission-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; flex: 1; min-height: 0; overflow: hidden; }",
        ".mission-sidebar { display: flex; flex-direction: column; height: 100%; min-height: 0; }",
        ".mission-filter-bar { display: flex; gap: 5px; margin-bottom: 12px; flex-wrap: wrap; }",
        ".filter-btn { display: inline-block; background: var(--phosphor-dim); border: 1px solid var(--border-color); color: var(--phosphor-color); padding: 3px 8px; font-family: var(--font-primary); font-size: 0.85rem; text-decoration: none; cursor: pointer; transition: all 0.2s; }",
        ".filter-btn.active, .filter-btn:hover { background: var(--phosphor-color); color: var(--bg-color); }",
        ".mission-list { flex: 1; min-height: 0; overflow-y: auto; border: 1px dashed var(--border-color); padding: 10px; background: rgba(var(--phosphor-rgb), 0.04); }",
        ".mission-card { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 12px; margin-bottom: 8px; border: 1px solid var(--phosphor-dim); background: rgba(var(--phosphor-rgb), 0.06); text-decoration: none; color: inherit; transition: all 0.15s ease; }",
        ".mission-card:hover, .mission-card.active { border-color: var(--border-color); background: rgba(var(--phosphor-rgb), 0.14); box-shadow: 0 0 8px var(--phosphor-glow); }",
        ".mission-card.bloqueada { opacity: 0.45; }",
        ".mission-card-title { font-family: var(--font-heading); font-size: 1.2rem; }",
        ".difficulty-badge { font-size: 0.8rem; padding: 2px 6px; border: 1px solid; font-weight: bold; white-space: nowrap; }",
        ".difficulty-easy { color: var(--phosphor-color); border-color: var(--phosphor-color); }",
        ".difficulty-medium { color: var(--aviso); border-color: var(--aviso); }",
        ".difficulty-hard { color: var(--alerta); border-color: var(--alerta); }",
        ".difficulty-extreme { color: var(--alerta); border-color: var(--alerta); border-style: dashed; text-shadow: 0 0 6px var(--alerta); }",
        ".mission-briefing-panel { border: 1px solid var(--border-color); padding: 20px; background: rgba(var(--phosphor-rgb), 0.05); display: flex; flex-direction: column; justify-content: space-between; overflow-y: auto; min-height: 0; }",
        ".briefing-header h3 { margin-bottom: 5px; }",
        ".briefing-destination { font-size: 0.95rem; opacity: 0.8; margin-bottom: 15px; }",
        ".briefing-content-body { flex: 1; }",
        ".briefing-section { margin-bottom: 15px; font-size: 1rem; }",
        ".briefing-objectives ul { list-style: square; padding-left: 20px; }",
        ".briefing-rewards { font-size: 0.95rem; border-top: 1px dashed var(--border-color); padding-top: 10px; margin-top: 10px; }",
        ".budget-display { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; background: rgba(0, 0, 0, 0.3); padding: 8px; border: 1px dashed var(--border-color); margin-top: 8px; font-size: 0.9rem; }",
        ".logistics-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 0.95rem; margin-top: 5px; }",
        ".risk-panel { border: 1px solid var(--border-color); background: rgba(var(--phosphor-rgb), 0.04); padding: 10px; }",
        ".risk-meter-container { display: flex; justify-content: space-between; align-items: center; }",
        ".launch-mission-btn { display: block; background: var(--phosphor-color); color: var(--bg-color); border: none; font-family: var(--font-heading); font-size: 1.4rem; padding: 10px; cursor: pointer; text-align: center; width: 100%; text-decoration: none; transition: opacity 0.2s; margin-top: 15px; }",
        ".launch-mission-btn:hover { opacity: 0.85; box-shadow: 0 0 12px var(--phosphor-glow); }",
        ".launch-mission-btn:disabled { opacity: 0.3; cursor: not-allowed; box-shadow: none; }",
        "input[type='range'] { accent-color: var(--phosphor-color); cursor: pointer; }",
        # Consola de Lenguaje y editor
        ".lg-console-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; flex: 1; min-height: 0; overflow: hidden; margin-top: 10px; }",
        ".lg-editor-pane, .lg-output-pane { display: flex; flex-direction: column; height: 100%; min-height: 0; }",
        ".lg-editor-toolbar { display: flex; gap: 10px; margin-bottom: 10px; }",
        "#lg-code-editor, textarea.area { width: 100%; background: rgba(0, 0, 0, 0.6); border: 1px solid var(--border-color); color: var(--phosphor-color); font-family: var(--font-primary); font-size: 1rem; padding: 15px; resize: none; outline: none; box-shadow: inset 0 0 5px var(--phosphor-glow); }",
        "#lg-code-editor { flex: 1; min-height: 0; }",
        "textarea.area { min-height: 60vh; }",
        ".lg-output-terminal { flex: 1; min-height: 0; border: 1px dashed var(--border-color); padding: 15px; background: rgba(var(--phosphor-rgb), 0.04); font-size: 0.95rem; overflow-y: auto; text-shadow: 0 0 2px var(--phosphor-glow); }",
        ".lg-status-bar { padding: 5px; font-size: 0.8rem; background: var(--phosphor-dim); display: flex; justify-content: space-between; margin-top: 5px; }",
        "button.boton { background: var(--phosphor-color); color: var(--bg-color); border: none; padding: 10px 16px; font-family: var(--font-heading); font-size: 1.2rem; cursor: pointer; align-self: flex-start; }",
        "button.boton:hover { opacity: 0.85; box-shadow: 0 0 12px var(--phosphor-glow); }",
        "form.editor { display: flex; flex-direction: column; gap: 8px; flex: 1; min-height: 0; }",
        ".pista-nota { font-size: 0.85rem; opacity: 0.8; border: 1px dashed var(--border-color); padding: 4px 8px; }",
        # Escritorio con aplicaciones (apps.lg)
        ".app-contenido { min-height: 100%; padding: 14px 18px 20px; }",
        ".app-cab { border-bottom: 1px dashed var(--border-color); margin-bottom: 12px; padding-bottom: 6px; }",
        ".app-cab h2 { margin: 0; padding: 0; border: 0; font-size: 1.6rem; }",
        ".sub { margin: 2px 0 10px; font-size: 0.85rem; opacity: 0.7; }",
        ".tarjeta { border: 1px solid var(--border-color); padding: 14px 16px; background: rgba(var(--phosphor-rgb), 0.03); box-shadow: inset 0 0 10px rgba(var(--phosphor-rgb), 0.06); }",
        ".fila { display: grid; grid-template-columns: 130px 1fr 70px 110px; gap: 12px; align-items: center; padding: 8px 4px; border-bottom: 1px dashed var(--phosphor-dim); }",
        ".fila:last-child { border-bottom: 0; }",
        ".fila-nombre { font-size: 1rem; text-transform: uppercase; }",
        ".fila-valor { text-align: right; font-variant-numeric: tabular-nums; }",
        ".barra-fondo { height: 12px; border: 1px solid var(--border-color); padding: 1px; }",
        ".barra-valor { height: 100%; background: repeating-linear-gradient(90deg, var(--phosphor-color) 0 6px, transparent 6px 8px); box-shadow: 0 0 6px var(--phosphor-glow); }",
        ".chip { display: inline-block; justify-self: start; font-size: 0.8rem; padding: 0 6px; border: 1px solid var(--phosphor-color); white-space: nowrap; }",
        ".chip.ok { color: var(--phosphor-color); }",
        ".chip.mal { color: var(--alerta); border-color: var(--alerta); animation: blink 1s infinite; }",
        ".chip.off { opacity: 0.5; border-style: dashed; }",
        ".chip.aviso { color: var(--aviso); border-color: var(--aviso); }",
        ".gases { display: flex; flex-wrap: wrap; gap: 30px; align-items: center; justify-content: center; }",
        ".fila-tanques { display: flex; flex-wrap: wrap; gap: 22px; justify-content: center; }",
        ".deposito { display: flex; flex-direction: column; align-items: center; width: 96px; }",
        ".tanque { width: 60px; height: 190px; border: 2px solid var(--border-color); background: repeating-linear-gradient(0deg, transparent 0 9px, rgba(var(--phosphor-rgb), 0.25) 9px 10px); overflow: hidden; display: flex; align-items: flex-end; }",
        ".nivel { width: 100%; box-shadow: 0 0 8px var(--phosphor-glow); filter: var(--filtro-mono); }",
        ".etiqueta { margin-top: 8px; font-size: 0.9rem; text-transform: uppercase; }",
        ".cifra { font-size: 0.85rem; opacity: 0.8; text-align: center; }",
        ".cifra-grande { font-family: var(--font-heading); font-size: 2.4rem; margin: 6px 0 2px; font-variant-numeric: tabular-nums; }",
        ".manometro-caja { text-align: center; }",
        ".manometro { width: 150px; height: 150px; border-radius: 50%; margin: 0 auto; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color); filter: var(--filtro-mono); }",
        ".manometro-centro { width: 102px; height: 102px; border-radius: 50%; background: var(--bg-color); border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; font-family: var(--font-heading); font-size: 1.8rem; font-variant-numeric: tabular-nums; }",
        ".comunicacion { display: flex; flex-wrap: wrap; gap: 30px; align-items: center; justify-content: center; }",
        ".antena-caja { width: 160px; height: 160px; color: var(--phosphor-color); filter: drop-shadow(0 0 6px var(--phosphor-glow)); }",
        ".antena { width: 160px; height: 160px; }",
        ".senal { display: flex; align-items: flex-end; gap: 10px; height: 140px; }",
        ".barra-senal { width: 26px; border: 1px dashed var(--border-color); }",
        ".barra-senal.on { background: var(--phosphor-color); border-style: solid; box-shadow: 0 0 8px var(--phosphor-glow); }",
        ".orbita-caja { position: relative; height: 280px; border: 1px solid var(--border-color); overflow: hidden; background: radial-gradient(ellipse at 50% 120%, rgba(var(--phosphor-rgb), 0.18), transparent 70%); }",
        ".orbita { position: absolute; left: 50%; top: 62%; width: 80%; height: 80%; transform: translate(-50%, -50%); border: 1px dashed var(--border-color); border-radius: 50%; opacity: 0.5; }",
        ".planeta { position: absolute; left: 50%; top: 62%; width: 120px; height: 120px; transform: translate(-50%, -50%); border: 1px solid var(--border-color); border-radius: 50%; background: repeating-linear-gradient(0deg, rgba(var(--phosphor-rgb), 0.25) 0 1px, transparent 1px 8px); box-shadow: 0 0 24px var(--phosphor-glow); }",
        ".nave { position: absolute; width: 10px; height: 10px; transform: translate(-50%, -50%); background: var(--aviso); box-shadow: 0 0 10px var(--aviso); }",
        ".orbita-texto { position: absolute; left: 12px; bottom: 10px; font-size: 0.9rem; }",
        ".mandos { display: flex; flex-direction: column; gap: 12px; margin-top: 14px; }",
        ".mando-fila { display: grid; grid-template-columns: 130px 1fr 130px; gap: 12px; align-items: center; }",
        ".pista { position: relative; height: 10px; border: 1px solid var(--border-color); }",
        ".menu-ayuda { font-size: 0.9rem; opacity: 0.8; padding: 6px 2px; }",
        ".pista-relleno { height: 100%; background: var(--phosphor-color); opacity: 0.6; }",
        ".pista-relleno.consumo { background: var(--aviso); }",
        ".mando { position: absolute; top: 50%; width: 6px; height: 18px; margin-left: -3px; transform: translateY(-50%); background: var(--aviso); box-shadow: 0 0 6px var(--aviso); }",
        ".energia { display: flex; flex-wrap: wrap; gap: 36px; align-items: center; justify-content: center; }",
        ".bateria-caja { text-align: center; }",
        ".bateria-tapa { width: 36px; height: 8px; margin: 0 auto; background: var(--border-color); }",
        ".bateria { width: 96px; height: 210px; border: 2px solid var(--border-color); overflow: hidden; display: flex; align-items: flex-end; margin: 0 auto; }",
        ".bateria-nivel { width: 100%; background: repeating-linear-gradient(0deg, var(--phosphor-color) 0 12px, transparent 12px 16px); }",
        ".bateria-nivel.bajo { background: repeating-linear-gradient(0deg, var(--alerta) 0 12px, transparent 12px 16px); }",
        ".flujos { flex: 1; min-width: 260px; display: flex; flex-direction: column; gap: 12px; }",
        ".fuentes { display: flex; flex-direction: column; gap: 8px; }",
        ".fuente { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 8px 10px; border: 1px dashed var(--border-color); }",
        # Escritorio: ventana, pestañas, línea de órdenes y barra de tareas (escritorio.lg)
        ".escritorio-raiz { display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 0; }",
        ".escritorio { flex: 1; min-height: 0; display: flex; align-items: stretch; justify-content: center; padding: 10px 12px; }",
        ".ventana { width: min(1000px, 100%); height: 100%; display: flex; flex-direction: column; min-height: 0; border: 1px solid var(--border-color); background: var(--bg-color); box-shadow: 0 0 14px var(--phosphor-glow), inset 0 0 12px var(--phosphor-glow); }",
        ".titulo-barra { position: relative; height: 30px; display: flex; align-items: center; justify-content: flex-end; padding: 0 6px 0 12px; flex: none; background: var(--phosphor-dim); border-bottom: 1px dashed var(--border-color); }",
        ".titulo { position: absolute; left: 12px; right: 130px; font-family: var(--font-heading); font-size: 1.2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; pointer-events: none; text-shadow: 0 0 6px var(--phosphor-glow); }",
        ".w7-botones { display: flex; gap: 4px; z-index: 1; }",
        ".w7-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 26px; height: 20px; padding: 0 4px; border: 1px solid var(--border-color); color: var(--phosphor-color); font-size: 0.85rem; text-decoration: none; }",
        ".w7-btn:hover { background: var(--phosphor-color); color: var(--bg-color); }",
        ".w7-btn.cerrar { color: var(--alerta); border-color: var(--alerta); }",
        ".w7-btn.cerrar:hover { background: var(--alerta); color: var(--bg-color); }",
        ".pestanas { display: flex; gap: 4px; padding: 4px 6px 0; border-bottom: 1px dashed var(--border-color); overflow-x: auto; flex: none; }",
        ".pestana-caja { display: flex; align-items: center; }",
        ".pestana { padding: 4px 12px; border: 1px solid var(--border-color); border-bottom: 0; background: var(--phosphor-dim); font-size: 0.9rem; text-decoration: none; white-space: nowrap; opacity: 0.7; }",
        ".pestana.activa { opacity: 1; background: var(--phosphor-color); color: var(--bg-color); }",
        ".pestana-caja .x { font-size: 0.9rem; text-decoration: none; padding: 0 6px 0 3px; opacity: 0.7; }",
        ".pestana-caja .x:hover { color: var(--alerta); }",
        ".contenido { flex: 1; min-height: 0; overflow: auto; position: relative; background: rgba(var(--phosphor-rgb), 0.02); }",
        "pre.salida { font-family: var(--font-primary); font-size: 0.95rem; line-height: 1.4; white-space: pre-wrap; word-break: break-word; padding: 10px 12px; text-shadow: 0 0 2px var(--phosphor-glow); overflow-y: auto; }",
        ".contenido pre.salida { height: 100%; margin: 0; }",
        ".linea { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-top: 1px dashed var(--border-color); flex: none; }",
        ".prompt { white-space: nowrap; font-weight: bold; text-shadow: 0 0 5px var(--phosphor-glow); }",
        ".campo { flex: 1; min-width: 0; background: transparent; border: 0; outline: none; font-size: 1.1rem; padding: 3px 0; text-shadow: 0 0 5px var(--phosphor-glow); }",
        ".campo::placeholder { color: var(--phosphor-color); opacity: 0.3; }",
        ".barra-tareas { flex: none; height: 44px; display: flex; align-items: stretch; border-top: 1px dashed var(--border-color); background: var(--phosphor-dim); }",
        ".inicio-orbe { width: 44px; flex: none; display: flex; align-items: center; justify-content: center; border-right: 1px solid var(--border-color); }",
        ".inicio-orbe::before { content: '◉'; font-size: 1.2rem; color: var(--phosphor-color); text-shadow: 0 0 8px var(--phosphor-glow); }",
        ".tareas-apps { display: flex; align-items: stretch; gap: 4px; flex: 1; min-width: 0; overflow-x: auto; padding: 4px 6px; }",
        ".tarea { display: flex; align-items: center; gap: 6px; padding: 0 10px; min-width: 40px; flex: 0 1 150px; overflow: hidden; border: 1px solid var(--phosphor-dim); text-decoration: none; color: var(--phosphor-color); opacity: 0.55; }",
        ".tarea.abierta { opacity: 0.9; border-color: var(--border-color); }",
        ".tarea:hover, .tarea.actual { opacity: 1; background: var(--phosphor-color); color: var(--bg-color); }",
        ".tarea-icono { width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; flex: none; }",
        ".tarea-icono svg { width: 18px; height: 18px; }",
        ".tarea-nombre { font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }",
        ".bandeja { flex: none; display: flex; align-items: center; padding: 0 10px; margin-left: 4px; border-left: 1px dashed var(--border-color); font-size: 0.8rem; max-width: 380px; }",
        ".bandeja-texto { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }",
        ".idiomas { display: inline-flex; gap: 3px; margin-left: 10px; }",
        ".idioma { font-size: 0.75rem; padding: 0 5px; border: 1px solid transparent; text-decoration: none; }",
        ".idioma:hover, .idioma.actual { border-color: var(--border-color); background: var(--phosphor-color); color: var(--bg-color); }",
        # Respuesta a pantallas pequeñas
        "@media (max-width: 900px) { .terminal-container { width: 100vw; height: 100vh; max-height: none; border: none; } .ascii-banner { font-size: 0.6rem; } }",
        "@media (max-width: 800px) { .mission-layout, .lg-console-layout { grid-template-columns: 1fr; } .lg-console-layout { overflow-y: auto; } }",
        "@media (max-width: 700px) { .fila { grid-template-columns: 1fr; gap: 4px; } .mando-fila { grid-template-columns: 1fr; } .tarea-nombre, .bandeja-texto { display: none; } }",
    ]
    return "<style>\n" + texto_unir(reglas, "\n") + "\n</style>"

# ---------- piezas de la página ----------

fn crt_separador() -> Nodo:
    return ui_elemento("span", ["class", "divider"], [ui_texto("|")])

fn crt_cabecera() -> Nodo:
    temas = crt_temas()
    mut enlaces: List[Nodo] = []
    for i in 0..len(temas):
        mut clase = "tema"
        if temas[i] == crt_tema:
            clase = "tema activo"
        enlaces.append(ui_elemento("a", ["href", "/tema/" + temas[i], "class", clase], [ui_texto("[" + texto_a_mayusculas(temas[i]) + "]")]))
    mut scan = "OFF"
    if crt_scan:
        scan = "ON"
    izquierda = ui_elemento("div", ["class", "status-left"], [
        ui_elemento("span", ["class", "blink-dot"], [ui_texto("●")]),
        ui_texto("SYS_ID: SFC-8088"),
        crt_separador(),
        ui_texto("MEM: 640K OK")
    ])
    mut derecha_hijos: List[Nodo] = [ui_elemento("span", ["class", "reloj"], [ui_texto("00:00:00")]), crt_separador(), ui_texto("COLOR:")]
    for i in 0..len(enlaces):
        derecha_hijos.append(enlaces[i])
    derecha_hijos.append(crt_separador())
    derecha_hijos.append(ui_elemento("a", ["href", "/escanlineas", "class", "escanlineas"], [ui_texto("[SCAN: " + scan + "]")]))
    derecha = ui_elemento("div", ["class", "status-right"], derecha_hijos)
    return ui_elemento("header", ["class", "terminal-header"], [izquierda, derecha])

fn crt_pie() -> Nodo:
    ayuda = ui_elemento("div", ["class", "footer-help"], [
        ui_elemento("span", [], [ui_texto(tr("crt.ayuda.elegir"))]),
        ui_elemento("span", [], [ui_texto(tr("crt.ayuda.pulsar"))]),
        ui_elemento("span", [], [ui_texto(tr("crt.ayuda.escribir"))])
    ])
    return ui_elemento("footer", ["class", "terminal-footer"], [
        ayuda,
        ui_elemento("div", ["class", "footer-version"], [ui_texto("SECURE_CHANNEL // 0xFF00EE")])
    ])

fn crt_estructura(cuerpo: Nodo) -> Nodo:
    mut clase_capa = "crt-overlay"
    if not crt_scan:
        clase_capa = "crt-overlay off"
    capa = ui_elemento("div", ["class", clase_capa], [
        ui_elemento("div", ["class", "scanline"], []),
        ui_elemento("div", ["class", "flicker"], [])
    ])
    contenedor = ui_elemento("div", ["class", "terminal-container"], [
        crt_cabecera(),
        ui_elemento("main", ["class", "terminal-body"], [cuerpo]),
        crt_pie()
    ])
    return ui_elemento("div", ["class", "crt-raiz"], [capa, contenedor])

fn crt_pagina(titulo: str, cuerpo: Nodo) -> str:
    partes = [
        "<!doctype html>\n<html lang=\"" + i18n_idioma_actual() + "\" data-theme=\"" + crt_tema + "\">\n<head>\n",
        "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n",
        "<title>" + ui_escapar(titulo) + " // SHIP FAULT CONTROL</title>\n",
        "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n",
        "<link href=\"https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&display=swap\" rel=\"stylesheet\">\n",
        crt_css(),
        "\n</head>\n<body>\n",
        ui_render(crt_estructura(cuerpo)),
        "\n</body>\n</html>\n",
    ]
    return texto_unir(partes, "")

fn crt_titulo(rotulo: str) -> Nodo:
    return ui_elemento("h2", [], [ui_texto("// " + rotulo)])

fn crt_volver(href: str, etiqueta: str) -> Nodo:
    return ui_elemento("div", ["class", "back-hint"], [
        ui_elemento("a", ["href", href, "class", "volver"], [ui_texto("< " + etiqueta + " >")])
    ])

fn crt_opcion(numero: int, etiqueta: str, sub: str, href: str, activa: bool) -> Nodo:
    mut clase = "menu-item"
    if activa:
        clase = "menu-item active"
    return ui_elemento("li", ["class", clase], [
        ui_elemento("a", ["href", href], [
            ui_elemento("span", ["class", "pointer"], [ui_texto(">")]),
            ui_texto(" "),
            ui_elemento("span", ["class", "key"], [ui_texto("[" + str(numero) + "]")]),
            ui_texto(" " + etiqueta + " "),
            ui_elemento("span", ["class", "sub-hint"], [ui_texto("(" + sub + ")")])
        ])
    ])

fn crt_menu(opciones: List[Nodo]) -> Nodo:
    return ui_elemento("nav", ["class", "menu-options", "role", "navigation"], [
        ui_elemento("ul", [], opciones)
    ])

fn crt_arranque(lineas: List[str], href_continuar: str) -> Nodo:
    mut filas: List[Nodo] = []
    for i in 0..len(lineas):
        filas.append(ui_elemento("p", [], [ui_texto(lineas[i])]))
    filas.append(ui_elemento("p", ["class", "boot-prompt"], [
        ui_elemento("a", ["href", href_continuar, "class", "boot-link"], [ui_texto(tr("crt.arranque.continuar"))])
    ]))
    return ui_elemento("div", ["class", "boot-screen"], [
        ui_elemento("div", ["class", "boot-logs"], filas)
    ])

fn crt_fila_config(etiqueta: str, valor: str, href: str) -> Nodo:
    return ui_elemento("div", ["class", "config-row"], [
        ui_elemento("label", [], [ui_texto(etiqueta)]),
        ui_elemento("a", ["href", href, "class", "config-btn"], [ui_texto(valor)])
    ])

# Pantalla de ajustes: tema (cada pulsación pasa al siguiente) y scanlines.
fn crt_ajustes() -> Nodo:
    mut scan = tr("crt.off")
    if crt_scan:
        scan = tr("crt.on")
    filas = ui_elemento("div", ["class", "config-options"], [
        crt_fila_config(tr("crt.ajustes.color"), texto_a_mayusculas(crt_tema), "/tema/" + crt_tema_siguiente()),
        crt_fila_config(tr("crt.ajustes.scanlines"), scan, "/escanlineas")
    ])
    return ui_elemento("section", ["class", "sub-screen"], [
        crt_titulo(tr("crt.ajustes.titulo")),
        filas,
        crt_volver("/menu", tr("crt.volver"))
    ])

fn crt_creditos() -> Nodo:
    return ui_elemento("section", ["class", "sub-screen"], [
        crt_titulo(tr("crt.creditos.titulo")),
        ui_elemento("div", ["class", "credits-content"], [
            ui_elemento("p", [], [ui_elemento("strong", [], [ui_texto("SHIP FAULT CONTROL")])]),
            ui_elemento("p", [], [ui_texto(tr("crt.creditos.desc"))]),
            ui_elemento("br", [], []),
            ui_elemento("p", [], [ui_texto("> " + tr("crt.creditos.equipo"))]),
            ui_elemento("p", [], [ui_texto("> " + tr("crt.creditos.motor"))]),
            ui_elemento("p", [], [ui_texto("> " + tr("crt.creditos.interfaz"))]),
            ui_elemento("br", [], []),
            ui_elemento("p", ["class", "blink-texto"], [ui_texto(tr("crt.creditos.gracias"))])
        ]),
        crt_volver("/menu", tr("crt.volver"))
    ])

# ---------- banner ASCII ----------
# Letras de 3 columnas y 5 filas con bloques.

fn crt_letra(c: str) -> List[str]:
    if c == "S":
        return ["███", "█  ", "███", "  █", "███"]
    if c == "H":
        return ["█ █", "█ █", "███", "█ █", "█ █"]
    if c == "I":
        return ["███", " █ ", " █ ", " █ ", "███"]
    if c == "P":
        return ["███", "█ █", "███", "█  ", "█  "]
    if c == "F":
        return ["███", "█  ", "██ ", "█  ", "█  "]
    if c == "A":
        return [" █ ", "█ █", "███", "█ █", "█ █"]
    if c == "U":
        return ["█ █", "█ █", "█ █", "█ █", "███"]
    if c == "L":
        return ["█  ", "█  ", "█  ", "█  ", "███"]
    if c == "T":
        return ["███", " █ ", " █ ", " █ ", " █ "]
    if c == "C":
        return ["███", "█  ", "█  ", "█  ", "███"]
    if c == "O":
        return ["███", "█ █", "█ █", "█ █", "███"]
    if c == "N":
        return ["█ █", "██ ", "█ █", "█ █", "█ █"]
    if c == "R":
        return ["██ ", "█ █", "██ ", "█ █", "█ █"]
    return ["   ", "   ", "   ", "   ", "   "]

fn crt_banner_fila(palabra: str, fila: int) -> str:
    mut partes: List[str] = []
    for i in 0..len(palabra):
        letra = crt_letra(recortar(palabra, i, i + 1))
        partes.append(letra[fila] + " ")
    return texto_unir(partes, "")

fn crt_banner() -> Nodo:
    mut filas: List[str] = []
    for f in 0..5:
        filas.append(crt_banner_fila("SHIP FAULT CONTROL", f))
    return ui_elemento("pre", ["class", "ascii-banner", "aria-label", "SHIP FAULT CONTROL"], [
        ui_texto(texto_unir(filas, "\n"))
    ])
