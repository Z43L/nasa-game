# src/main.lg: servidor del juego (framework web de Lenguaje: lib/web + lib/ui), interfaz CRT.
#
# Flujo: arranque (/) -> menú principal (/menu) -> juego (/juego), misiones, consola Lenguaje,
# partidas guardadas, ajustes (tema y scanlines) y créditos. Sin JavaScript: enlaces y formularios.
#
# Rutas principales:
#   GET  /                      arranque (la primera vez) o menú
#   GET  /menu                  menú principal
#   POST /menu/cmd              línea del menú: número 1-6 o una orden de la terminal
#   GET  /juego                 terminal y aplicaciones
#   POST /cmd                   orden de la terminal (campo "linea")
#   GET  /app/:id  /cerrar/:id  abre o cierra una aplicación
#   GET  /misiones  /misiones/:f  /mision/:n   selección de misiones (filtro y misión)
#   POST /mision/lanzar         inicia la misión (campo "numero")
#   GET  /consola  /consola/plantilla/:id   consola de Lenguaje
#   POST /consola/ejecutar      compila y ejecuta el código (campo "texto")
#   GET  /partidas              ranuras de partida guardada
#   GET  /partida/guardar/:n  /partida/cargar/:n
#   GET  /ajustes  /tema/:nombre  /escanlineas  /creditos
#   GET  /editar/:nombre  POST /guardar/:nombre   editor de scripts/
#   GET  /idioma/:codigo        cambia el idioma (es, en, fr, ja)
#   GET  /fondo.jpg             imagen de fondo (no se usa en el diseño CRT; se mantiene)
#
# Compilar y ejecutar desde juego/: lgpm construir && lgpm ejecutar

import app
import router
import respuesta
import http
import tcp
import datos
import texto
import i18n
import crt
