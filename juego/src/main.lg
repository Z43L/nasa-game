# src/main.lg: servidor de la terminal web de la nave (framework web de Lenguaje: lib/web + lib/ui).
#
# Rutas:
#   GET  /                    escritorio: barra de tareas, ventana con la terminal y las aplicaciones
#   POST /cmd                 envía una orden (formulario text/plain, campo "linea")
#   GET  /app/:id             abre una aplicación o la terminal ("terminal", "sensores", "gases"...)
#   GET  /cerrar/:id          cierra una aplicación
#   GET  /idioma/:codigo      cambia el idioma (es, en, fr, ja)
#   GET  /editar/:nombre      editor de scripts/NOMBRE
#   POST /guardar/:nombre     guarda el script (campo "texto")
#   GET  /fondo.jpg           imagen de fondo (fondo.jpg en juego/)
#
# Compilar y ejecutar desde juego/ (ver README.md): lgpm construir && lgpm ejecutar

import app
import router
import respuesta
import http
import tcp
import datos
import texto
import i18n
import pantalla
import escritorio
import apps
import shell
import misiones

fn primera_palabra_despues_de_orden(linea: str) -> str:
    p = shell_palabras(linea)
    if len(p) < 2:
        return ""
    return p[1]

fn procesar_orden(linea: str):
    l = texto_recortar_espacios(linea)
    if l == "":
        return
    log_agregar(tr("ui.prompt") + " " + l)
    if shell_orden(shell_palabras(l)[0]) == "limpiar":
        log_limpiar()
        return
    if shell_orden(shell_palabras(l)[0]) == "editar":
        return
    log_agregar(shell_ejecutar(l))

fn respuesta_pagina(cuerpo: str) -> Respuesta:
    return web_respuesta_html(200, cuerpo)

# Imagen de fondo de la terminal (fondo.jpg, en juego/). Se lee una vez al arrancar.
mut fondo_jpg = ""
if shell_existe("fondo.jpg"):
    fondo_jpg = leer_texto("fondo.jpg")

fn respuesta_fondo() -> Respuesta:
    cabeceras = [HttpCabecera(nombre: "Content-Type", valor: "image/jpeg"), HttpCabecera(nombre: "Cache-Control", valor: "max-age=86400")]
    return Respuesta(estado: 200, motivo: "OK", cabeceras: cabeceras, cuerpo: fondo_jpg)

# Traducciones: se cargan una vez. Si falta el fichero, la interfaz sigue en español con claves visibles.
mut error_traducciones = i18n_cargar()
if error_traducciones != "":
    print("traducciones:", error_traducciones)

proceso_ejecutar("mkdir -p scripts run")
log_agregar(tr("msg.bienvenida"))
log_agregar(trc("msg.bienvenida2", [tr("cmd.misiones"), tr("cmd.ayuda")]))

enrutador = web_nuevo_enrutador()
web_agregar(enrutador, "GET", "/", 1)
web_agregar(enrutador, "POST", "/cmd", 2)
web_agregar(enrutador, "GET", "/editar/:nombre", 3)
web_agregar(enrutador, "POST", "/guardar/:nombre", 4)
web_agregar(enrutador, "GET", "/fondo.jpg", 5)
web_agregar(enrutador, "GET", "/app/:id", 6)
web_agregar(enrutador, "GET", "/cerrar/:id", 7)
web_agregar(enrutador, "GET", "/idioma/:codigo", 8)

servidor = escuchar(8080)
if servidor < 0:
    print("no se pudo escuchar en el puerto 8080")
else:
    print("terminal de la nave en http://localhost:8080")
    while true:
        s = web_recibir(servidor, enrutador, 5000)
        if s.conexion < 0:
            continue
        if not s.peticion.valida:
            web_responder(s, http_respuesta_texto(400, tr("msg.peticion") + "\n"))
        elif s.id == 1:
            mision_avanzar()
            web_responder(s, respuesta_pagina(escritorio_html()))
        elif s.id == 2:
            linea = cuerpo_campo(s.peticion.cuerpo, "linea")
            if shell_orden(shell_palabras(texto_recortar_espacios(linea))[0]) == "editar" and len(shell_palabras(linea)) > 1:
                web_responder(s, web_respuesta_redireccion("/editar/" + primera_palabra_despues_de_orden(linea)))
            else:
                procesar_orden(linea)
                web_responder(s, web_respuesta_redireccion("/"))
        elif s.id == 3:
            nombre = s.parametros[0]
            if not shell_nombre_valido(nombre):
                log_agregar(trc("msg.nombre_corto", [nombre]))
                web_responder(s, web_respuesta_redireccion("/"))
            else:
                mut contenido = ""
                if shell_existe("scripts/" + nombre):
                    contenido = leer_texto("scripts/" + nombre)
                web_responder(s, respuesta_pagina(pantalla_editor(nombre, contenido)))
        elif s.id == 4:
            nombre = s.parametros[0]
            if not shell_nombre_valido(nombre):
                log_agregar(trc("msg.nombre_corto", [nombre]))
            else:
                escribir_texto("scripts/" + nombre, cuerpo_campo(s.peticion.cuerpo, "texto"))
                log_agregar(trc("msg.guardado", [nombre]))
            web_responder(s, web_respuesta_redireccion("/"))
        elif s.id == 5:
            if fondo_jpg == "":
                web_responder(s, http_respuesta_texto(404, tr("msg.sin_fondo") + "\n"))
            else:
                web_responder(s, respuesta_fondo())
        elif s.id == 6:
            escr_abrir(s.parametros[0])
            web_responder(s, web_respuesta_redireccion("/"))
        elif s.id == 7:
            escr_cerrar(s.parametros[0])
            web_responder(s, web_respuesta_redireccion("/"))
        elif s.id == 8:
            i18n_cambiar(s.parametros[0])
            web_responder(s, web_respuesta_redireccion("/"))
        else:
            web_responder(s, http_respuesta_texto(404, tr("msg.no_encontrado") + "\n"))
    cerrar(servidor)
