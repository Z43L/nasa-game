# src/shell.lg: intérprete de órdenes de la terminal y ejecución de scripts.
#
#   shell_ejecutar(linea: str) -> str   ejecuta una línea (puede llevar tuberías "|")
#   shell_ejecutar_script(nombre) -> str compila scripts/NOMBRE con lgc y lo ejecuta
#
# Las órdenes y los sistemas se aceptan con su nombre interno o con el nombre de cualquier idioma
# (ver traducciones.json, claves cmd.*, sys.* y tema.*).
#
# Protocolo con un script (por FIFO, run/in y run/out):
#   script -> servidor:  "@CMD orden" cuando llama a nave_ejecutar
#   servidor -> script:  la respuesta, línea a línea, seguida de "@FIN"
#   cualquier otra línea que imprime el script se muestra en la terminal.
# El script se mata a los 60 s (perl alarm), así que nunca bloquea el servidor para siempre.

import texto
import cadena
import tiempo
import proceso
import datos
import manual
import sim
import misiones
import i18n

mut en_script = false
mut ruta_lgc = "../lenguaje/build/bin/lgc"
mut ruta_lib = "lib"
mut ruta_nucleo = "../lenguaje/lib/nucleo"
mut ruta_stdlib = "../lenguaje/stdlib"

fn shell_ordenes() -> List[str]:
    return ["ayuda", "man", "man-code", "estado", "sensores", "valor", "diagnostico", "reparar", "encender", "apagar", "ajustar", "mision", "misiones", "iniciar", "esperar", "ls", "cat", "editar", "ejecutar", "echo", "pwd", "whoami", "limpiar", "idioma"]

fn shell_sistemas() -> List[str]:
    return ["reactor", "refrigeracion", "energia", "oxigeno", "comunicaciones", "co2", "hidrogeno"]

# Id interno de una orden escrita en cualquier idioma ("status" -> "estado").
fn shell_orden(palabra: str) -> str:
    return i18n_canonico("cmd.", shell_ordenes(), palabra)

# Id interno de un sistema ("oxígeno" -> "oxigeno"). "" si no existe.
fn shell_sistema(palabra: str) -> str:
    id = i18n_canonico("sys.", shell_sistemas(), palabra)
    if sim_existe(id):
        return id
    return ""

fn shell_palabras(s: str) -> List[str]:
    mut out: List[str] = []
    partes = texto_dividir(s, " ")
    for i in 0..len(partes):
        if partes[i] != "":
            out.append(partes[i])
    return out

fn shell_relleno(s: str, n: int) -> str:
    if len(s) >= n:
        return s + " "
    return s + texto_repetir(" ", n - len(s))

fn shell_es_entero(s: str) -> bool:
    if len(s) == 0:
        return false
    for i in 0..len(s):
        c = recortar(s, i, i + 1)
        if not texto_contiene("-0123456789", c):
            return false
    return true

fn shell_nombre_valido(n: str) -> bool:
    if len(n) < 4 or len(n) > 40:
        return false
    if not texto_termina_por(n, ".lg"):
        return false
    for i in 0..len(n):
        c = recortar(n, i, i + 1)
        if not texto_contiene("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.", c):
            return false
    return not texto_contiene(n, "..")

# ---------- órdenes de la nave ----------

# Sin relleno de columnas: len cuenta bytes y las tildes o el japonés descuadrarían la tabla.
fn shell_linea_sistema(s: Sistema) -> str:
    return sim_nombre(s) + ": " + str(s.valor) + "  [" + str(s.minimo) + "-" + str(s.maximo) + "]  " + sim_estado(s)

fn shell_estado(args: List[str]) -> str:
    if len(args) == 0:
        mut lineas: List[str] = [tr("col.sistema") + " · " + tr("col.valor") + " · " + tr("col.rango") + " · " + tr("col.estado")]
        todos = sim_lista()
        for i in 0..len(todos):
            lineas.append(shell_linea_sistema(todos[i]))
        return texto_unir(lineas, "\n")
    id = shell_sistema(args[0])
    if id == "":
        return trc("msg.sistema_desconocido", [args[0]])
    s = sim_s(id)
    mut estado_txt = tr("msg.apagado")
    if s.activo:
        estado_txt = tr("msg.activo")
    return shell_linea_sistema(s) + "\n" + trc("msg.objetivo", [str(s.objetivo), estado_txt])

fn shell_valor(args: List[str]) -> str:
    mut id = ""
    if len(args) > 0:
        id = shell_sistema(args[0])
    if id == "":
        return tr("msg.error")
    return str(sim_s(id).valor)

fn shell_diagnostico(args: List[str]) -> str:
    mut id = ""
    if len(args) > 0:
        id = shell_sistema(args[0])
    if id == "":
        return trc("msg.uso_sistema", [tr("cmd.diagnostico")])
    mut s = sim_s(id)
    s.diagnosticado = true
    if s.averia == "":
        return trc("msg.sin_averias", [sim_nombre(s)])
    return trc("msg.diagnostico", [sim_nombre(s), tr(s.averia), str(s.deriva), tr("cmd.reparar")])

fn shell_reparar(args: List[str]) -> str:
    mut id = ""
    if len(args) > 0:
        id = shell_sistema(args[0])
    if id == "":
        return trc("msg.uso_sistema", [tr("cmd.reparar")])
    mut s = sim_s(id)
    if s.averia == "":
        return trc("msg.ya_operativo", [sim_nombre(s)])
    if not s.diagnosticado:
        return trc("msg.primero_diag", [tr("cmd.diagnostico"), sim_nombre(s)])
    s.averia = ""
    s.deriva = 0
    s.diagnosticado = false
    return trc("msg.reparado", [sim_nombre(s)])

fn shell_activar(args: List[str], activo: bool) -> str:
    mut id = ""
    if len(args) > 0:
        id = shell_sistema(args[0])
    if id == "":
        return trc("msg.uso_activar", [tr("cmd.encender"), tr("cmd.apagar")])
    mut s = sim_s(id)
    s.activo = activo
    if activo:
        return trc("msg.encendido", [sim_nombre(s)])
    return trc("msg.apagado_sis", [sim_nombre(s)])

fn shell_ajustar(args: List[str]) -> str:
    mut id = ""
    if len(args) > 0:
        id = shell_sistema(args[0])
    if len(args) < 2 or id == "" or not shell_es_entero(args[1]):
        return trc("msg.uso_ajustar", [tr("cmd.ajustar")])
    mut s = sim_s(id)
    if s.nombre != "refrigeracion" and s.nombre != "oxigeno" and s.nombre != "comunicaciones":
        return trc("msg.no_regulado", [sim_nombre(s)])
    s.objetivo = int(args[1])
    if s.objetivo < s.minimo:
        s.objetivo = s.minimo
    if s.objetivo > s.maximo:
        s.objetivo = s.maximo
    return trc("msg.objetivo_fijado", [sim_nombre(s), str(s.objetivo)])

fn shell_iniciar(args: List[str]) -> str:
    if len(args) == 0 or not shell_es_entero(args[0]):
        return trc("msg.uso_iniciar", [tr("cmd.iniciar"), tr("cmd.misiones")])
    return mision_iniciar(int(args[0]))

fn shell_esperar(args: List[str]) -> str:
    if len(args) == 0 or not shell_es_entero(args[0]):
        return trc("msg.uso_esperar", [tr("cmd.esperar")])
    s = int(args[0])
    if s < 1 or s > 60:
        return trc("msg.esperar_rango", [tr("cmd.esperar")])
    tiempo_dormir_ms(s * 1000)
    mision_avanzar()
    return trc("msg.esperados", [str(s)])

# ---------- ficheros del juego ----------

fn shell_existe(ruta: str) -> bool:
    return proceso_ejecutar("test -f " + ruta) == 0

fn shell_ls() -> str:
    proceso_ejecutar("mkdir -p run && ls scripts > run/ls.txt 2>/dev/null")
    return texto_recortar_espacios(leer_texto("run/ls.txt"))

fn shell_cat(args: List[str]) -> str:
    if len(args) == 0 or not shell_nombre_valido(args[0]):
        return trc("msg.uso_fichero", [tr("cmd.cat")])
    ruta = "scripts/" + args[0]
    if not shell_existe(ruta):
        return trc("msg.no_existe", [args[0]])
    return leer_texto(ruta)

# ---------- tuberías ----------

fn shell_filtrar(orden: str, entrada: str) -> str:
    p = shell_palabras(orden)
    if len(p) == 0:
        return entrada
    mut args: List[str] = []
    for i in 1..len(p):
        args.append(p[i])
    if p[0] == "grep":
        mut out: List[str] = []
        for l in texto_dividir(entrada, "\n"):
            if len(args) > 0 and texto_contiene(l, args[0]):
                out.append(l)
        return texto_unir(out, "\n")
    if p[0] == "contar" or p[0] == "count" or p[0] == "compter":
        if entrada == "":
            return "0"
        return str(len(texto_dividir(entrada, "\n")))
    if p[0] == "mayus" or p[0] == "upper" or p[0] == "majuscules":
        return texto_a_mayusculas(entrada)
    return trc("msg.tuberia", [p[0]])

fn shell_una(linea: str) -> str:
    p = shell_palabras(linea)
    if len(p) == 0:
        return ""
    orden = shell_orden(p[0])
    mut args: List[str] = []
    for i in 1..len(p):
        args.append(p[i])
    if orden == "ayuda":
        return manual_comandos()
    if orden == "man":
        if len(args) == 0:
            return manual_comandos()
        return manual_comando(shell_orden(args[0]))
    if orden == "man-code":
        if len(args) == 0:
            return manual_temas()
        return manual_codigo(args[0])
    if orden == "estado" or orden == "sensores":
        return shell_estado(args)
    if orden == "valor":
        return shell_valor(args)
    if orden == "diagnostico":
        return shell_diagnostico(args)
    if orden == "reparar":
        return shell_reparar(args)
    if orden == "encender":
        return shell_activar(args, true)
    if orden == "apagar":
        return shell_activar(args, false)
    if orden == "ajustar":
        return shell_ajustar(args)
    if orden == "mision":
        return mision_info()
    if orden == "misiones":
        return mision_listar()
    if orden == "iniciar":
        return shell_iniciar(args)
    if orden == "esperar":
        return shell_esperar(args)
    if orden == "ls":
        return shell_ls()
    if orden == "cat":
        return shell_cat(args)
    if orden == "editar":
        mut nombre_ed = "FICHERO.lg"
        if len(args) > 0:
            nombre_ed = args[0]
        return trc("msg.editor_web", [tr("cmd.editar"), nombre_ed])
    if orden == "ejecutar":
        if len(args) == 0:
            return trc("msg.uso_fichero", [tr("cmd.ejecutar")])
        return shell_ejecutar_script(args[0])
    if orden == "echo":
        return texto_unir(args, " ")
    if orden == "pwd":
        return tr("msg.pwd")
    if orden == "whoami":
        return tr("msg.whoami")
    if orden == "limpiar":
        return ""
    if orden == "idioma":
        if len(args) == 0:
            return trc("msg.idioma_uso", [tr("cmd.idioma")])
        if i18n_cambiar(args[0]):
            return trc("msg.idioma_cambiado", [args[0]])
        return trc("msg.idioma_no", [args[0], i18n_disponibles()])
    return trc("msg.comando_no", [p[0], tr("cmd.ayuda")])

# Ejecuta una línea completa, con tuberías (orden | grep X | contar).
fn shell_ejecutar(linea: str) -> str:
    mision_avanzar()
    l = texto_recortar_espacios(linea)
    if l == "":
        return ""
    tramos = texto_dividir(l, "|")
    mut salida = shell_una(tramos[0])
    for i in 1..len(tramos):
        salida = shell_filtrar(tramos[i], salida)
    return salida

# ---------- scripts ----------

fn shell_ejecutar_script(nombre: str) -> str:
    if en_script:
        return tr("msg.anidado")
    if not shell_nombre_valido(nombre):
        return trc("msg.nombre_invalido", [nombre])
    if not shell_existe("scripts/" + nombre):
        return trc("msg.no_existe", ["scripts/" + nombre]) + " " + trc("msg.crear_antes", [tr("cmd.editar"), nombre])
    proceso_ejecutar("mkdir -p run && rm -f run/in run/out && mkfifo run/in run/out")
    orden_compilar = ruta_lgc + " scripts/" + nombre + " -I " + ruta_lib + " -I " + ruta_nucleo + " -I " + ruta_stdlib + " -o run/prog > run/compile.txt 2>&1"
    if proceso_ejecutar(orden_compilar) != 0:
        return trc("msg.error_compilar", [nombre, leer_texto("run/compile.txt")])
    proceso_ejecutar("(perl -e 'alarm 60; exec @ARGV' ./run/prog < run/in > run/out 2>&1 &)")
    en_script = true
    w = proceso_abrir("run/in", "w")
    r = proceso_abrir("run/out", "r")
    mut salida = trc("msg.en_ejecucion", [nombre]) + "\n"
    while not proceso_fin(r):
        l = proceso_leer_linea(r)
        if texto_empieza_por(l, "@CMD "):
            orden = texto_recortar_espacios(recortar(l, 5, len(l)))
            resp = shell_ejecutar(orden)
            proceso_escribir(w, resp + "\n@FIN\n")
        elif l != "":
            salida = salida + l + "\n"
    proceso_cerrar(w)
    proceso_cerrar(r)
    en_script = false
    return salida + trc("msg.terminado", [nombre])
