# src/misiones.lg: misiones, reloj de misión y puntuación.
#
# El reloj es real: cada segundo transcurrido avanza un paso de simulación (sim_paso) y
# comprueba el objetivo de la misión. Las misiones se desbloquean en orden.
#
# API (la usa shell.lg):
#   mision_avanzar()              avanza el reloj; llamar antes de cada orden
#   mision_iniciar(n: int) -> str  empieza la misión n (1-based); devuelve el texto o un error
#   mision_info() -> str           estado de la misión actual
#   mision_listar() -> str         todas las misiones con su estado
#   mision_en_curso() -> bool
#   mision_restante_s() -> int     segundos que quedan (0 si no hay misión en curso)
#
# Getters para la interfaz (índice i 0-based):
#   mision_total() -> int, mision_titulo(i) -> str, mision_briefing(i) -> str (traducidos),
#   mision_limite(i) -> int, mision_dificultad(i) -> str (clave dif.*),
#   mision_estado_de(i) -> int (0 bloqueada, 1 disponible, 2 en curso, 3 completada, 4 fallida),
#   mision_seleccionable(i) -> bool (disponible, en curso, completada o fallida).
#
# Serialización: mision_a_json() -> str, mision_desde_json(texto) -> str ("" si va bien).

import tiempo
import sim
import i18n
import json
import mision_modelo
import mis_g1
import mis_g2
import mis_g3
import mis_g4
import mis_g5

struct Mision:
    titulo: str
    briefing: str
    limite_s: int
    racha_necesaria: int
    dificultad: str

# Misiones de datos (7 en adelante): se añaden de los grupos mis_g1..mis_g5, en ese orden.
fn misiones_extra() -> List[MisionDato]:
    mut l: List[MisionDato] = []
    g1 = mis_g1()
    for i in 0..len(g1):
        l.append(g1[i])
    g2 = mis_g2()
    for i in 0..len(g2):
        l.append(g2[i])
    g3 = mis_g3()
    for i in 0..len(g3):
        l.append(g3[i])
    g4 = mis_g4()
    for i in 0..len(g4):
        l.append(g4[i])
    g5 = mis_g5()
    for i in 0..len(g5):
        l.append(g5[i])
    return l

mut extra_misiones: List[MisionDato] = misiones_extra()

fn misiones_lista() -> List[Mision]:
    mut l: List[Mision] = []
    l.append(Mision(titulo: "mision.1.titulo", briefing: "mision.1.briefing", limite_s: 120, racha_necesaria: 1, dificultad: "dif.facil"))
    l.append(Mision(titulo: "mision.2.titulo", briefing: "mision.2.briefing", limite_s: 90, racha_necesaria: 1, dificultad: "dif.facil"))
    l.append(Mision(titulo: "mision.3.titulo", briefing: "mision.3.briefing", limite_s: 150, racha_necesaria: 1, dificultad: "dif.media"))
    l.append(Mision(titulo: "mision.4.titulo", briefing: "mision.4.briefing", limite_s: 180, racha_necesaria: 15, dificultad: "dif.dificil"))
    l.append(Mision(titulo: "mision.5.titulo", briefing: "mision.5.briefing", limite_s: 120, racha_necesaria: 10, dificultad: "dif.dificil"))
    l.append(Mision(titulo: "mision.6.titulo", briefing: "mision.6.briefing", limite_s: 200, racha_necesaria: 10, dificultad: "dif.extrema"))
    for i in 0..len(extra_misiones):
        d = extra_misiones[i]
        l.append(Mision(titulo: d.titulo, briefing: d.briefing, limite_s: d.limite_s, racha_necesaria: d.racha, dificultad: d.dificultad))
    return l

mut lista_misiones: List[Mision] = misiones_lista()
mut actual = -1
mut estado = 0
mut completadas = 0
mut transcurrido_s = 0
mut racha_s = 0
mut motivo_fin = ""
mut puntos = 0
# Último instante (segundos de reloj de pared) hasta el que se ha simulado. Va en el estado de la partida.
mut ultimo_s = 0

fn mision_en_curso() -> bool:
    return estado == 1

fn mision_numero() -> int:
    return actual + 1

fn mision_estado_actual() -> int:
    return estado

fn mision_valida(i: int) -> bool:
    return i >= 0 and i < len(lista_misiones)

fn mision_total() -> int:
    return len(lista_misiones)

fn mision_titulo(i: int) -> str:
    if not mision_valida(i):
        return ""
    return tr(lista_misiones[i].titulo)

fn mision_briefing(i: int) -> str:
    if not mision_valida(i):
        return ""
    return tr(lista_misiones[i].briefing)

fn mision_limite(i: int) -> int:
    if not mision_valida(i):
        return 0
    return lista_misiones[i].limite_s

# Clave de dificultad: dif.facil, dif.media, dif.dificil o dif.extrema.
# Tipo de la misión: tipo.comando, tipo.programar o tipo.ambas.
fn mision_tipo(i: int) -> str:
    if not mision_valida(i):
        return ""
    if i >= 6:
        return extra_misiones[i - 6].tipo
    if i == 3:
        return "tipo.programar"
    if i >= 4:
        return "tipo.ambas"
    return "tipo.comando"

fn mision_dificultad(i: int) -> str:
    if not mision_valida(i):
        return ""
    return lista_misiones[i].dificultad

# 0 bloqueada, 1 disponible, 2 en curso, 3 completada, 4 fallida.
fn mision_estado_de(i: int) -> int:
    if not mision_valida(i):
        return 0
    if i < completadas:
        return 3
    if i > completadas:
        return 0
    if estado == 1 and actual == i:
        return 2
    if estado == 3 and actual == i:
        return 4
    return 1

# Se puede abrir su briefing: disponible, en curso, completada o fallida (no bloqueada).
fn mision_seleccionable(i: int) -> bool:
    return mision_estado_de(i) != 0

# Progreso de la misión actual en %: 0 sin misión, 100 completada.
fn mision_progreso_pct() -> int:
    if estado == 1:
        return transcurrido_s * 100 / lista_misiones[actual].limite_s
    if estado == 2:
        return 100
    return 0

fn mision_restante_s() -> int:
    if estado != 1:
        return 0
    return lista_misiones[actual].limite_s - transcurrido_s

# Objetivo de cada misión, comprobado cada segundo.
# Una condición del objetivo genérico (misiones de datos).
fn mis_cond_cumple(c: Condicion) -> bool:
    s = sim_s(c.sistema)
    if c.tipo == 1:
        return sim_sano(s)
    if c.tipo == 2:
        return s.activo
    if c.op == 0:
        return s.valor >= c.valor
    if c.op == 1:
        return s.valor <= c.valor
    return s.valor == c.valor

fn mision_condicion(i: int) -> bool:
    if i >= 6:
        d = extra_misiones[i - 6]
        for k in 0..len(d.objetivo):
            if not mis_cond_cumple(d.objetivo[k]):
                return false
        return len(d.objetivo) > 0
    if i == 0:
        ref = sim_s("refrigeracion")
        return sim_sano(ref) and sim_s("reactor").valor <= 480
    if i == 1:
        oxi = sim_s("oxigeno")
        return sim_sano(oxi) and oxi.valor >= 95
    if i == 2:
        rea = sim_s("reactor")
        return sim_sano(rea) and sim_s("energia").valor >= 30
    if i == 3:
        return sim_todos_sanos()
    if i == 4:
        co2 = sim_s("co2")
        return sim_sano(co2) and co2.valor <= 5
    if i == 5:
        return sim_todos_sanos()
    return false

# Racha necesaria de la misión actual (1 si el objetivo basta en un instante).
fn mision_racha_necesaria() -> int:
    return lista_misiones[actual].racha_necesaria

# Comprueba el objetivo ahora mismo sin cambiar nada.
fn mision_comprobar() -> str:
    if estado != 1:
        return tr("mision.no_en_curso")
    m = lista_misiones[actual]
    if mision_condicion(actual):
        if racha_s + 1 >= m.racha_necesaria:
            return trc("mision.comprobar_ok", [str(actual + 1)])
        return trc("mision.racha", [str(racha_s + 1), str(m.racha_necesaria)])
    return trc("mision.comprobar_no", [str(actual + 1), tr(m.briefing)])

# Termina la misión ya: completada si el objetivo se cumple en este instante, si no fallida.
fn mision_finalizar() -> str:
    if estado != 1:
        return tr("mision.no_en_curso")
    m = lista_misiones[actual]
    if mision_condicion(actual) and racha_s + 1 >= m.racha_necesaria:
        mision_completar()
        return trc("mision.finalizada_ok", [str(actual + 1), str(puntos)])
    mision_fallar("fallo.objetivo")
    return trc("mision.finalizada_fallo", [str(actual + 1)])

fn mision_dos_digitos(n: int) -> str:
    if n < 10:
        return "0" + str(n)
    return str(n)

# Reloj de la cabecera: "M1 01:25" en curso, "M1 OK" completada, "M1 ERR" fallida, "--:--" sin misión.
fn mision_reloj_texto() -> str:
    if estado == 1:
        r = mision_restante_s()
        return "M" + str(actual + 1) + " " + mision_dos_digitos(r / 60) + ":" + mision_dos_digitos(r % 60)
    if estado == 2:
        return "M" + str(actual + 1) + " OK"
    if estado == 3:
        return "M" + str(actual + 1) + " ERR"
    return "--:--"

fn mision_completar():
    estado = 2
    motivo_fin = "completada"
    puntos = (lista_misiones[actual].limite_s - transcurrido_s) * 10 + 100
    if actual == completadas:
        completadas = completadas + 1

fn mision_fallar(motivo: str):
    estado = 3
    motivo_fin = motivo

# Un segundo de misión: simulación, objetivo y fallos.
fn mision_segundo():
    if estado != 1:
        return
    sim_paso()
    transcurrido_s = transcurrido_s + 1
    mut cumple = mision_condicion(actual)
    if cumple:
        racha_s = racha_s + 1
    else:
        racha_s = 0
    rea = sim_s("reactor")
    ene = sim_s("energia")
    co2 = sim_s("co2")
    if racha_s >= lista_misiones[actual].racha_necesaria:
        mision_completar()
    elif rea.valor > rea.maximo:
        mision_fallar("fallo.reactor")
    elif ene.valor <= 0:
        mision_fallar("fallo.energia")
    elif co2.valor > co2.maximo:
        mision_fallar("fallo.co2")
    elif transcurrido_s >= lista_misiones[actual].limite_s:
        mision_fallar("fallo.tiempo")

# Avanza el reloj real: un paso por cada segundo transcurrido (como mucho 300 por llamada).
fn mision_avanzar():
    ahora = tiempo_pared_unix_s()
    if ultimo_s == 0:
        ultimo_s = ahora
    mut pasos = ahora - ultimo_s
    if pasos > 300:
        pasos = 300
    ultimo_s = ahora
    for k in 0..pasos:
        mision_segundo()

# Estado inicial de misiones (sin partida): ninguna misión iniciada.
fn misiones_reiniciar():
    actual = -1
    estado = 0
    completadas = 0
    transcurrido_s = 0
    racha_s = 0
    motivo_fin = ""
    puntos = 0
    ultimo_s = 0

# Fallos iniciales de cada misión.
fn mision_preparar(i: int):
    sim_reiniciar()
    if i >= 6:
        d = extra_misiones[i - 6]
        for k in 0..len(d.averias):
            a = d.averias[k]
            sim_averiar(a.sistema, a.clave, a.deriva)
            if a.valor != 0:
                mut s = sim_s(a.sistema)
                s.valor = a.valor
        return
    if i == 0:
        mut rea0 = sim_s("reactor")
        rea0.valor = 500
        sim_averiar("refrigeracion", "av.bomba", 0)
    elif i == 1:
        sim_averiar("oxigeno", "av.fuga", -4)
    elif i == 2:
        sim_averiar("reactor", "av.inyector", 0)
        mut ene = sim_s("energia")
        ene.valor = 60
    elif i == 3:
        sim_averiar("comunicaciones", "av.antena", -3)
    elif i == 4:
        sim_averiar("co2", "av.co2", 1)
    elif i == 5:
        sim_averiar("comunicaciones", "av.tormenta", -3)
        sim_averiar("energia", "av.tormenta", -2)

fn mision_iniciar(n: int) -> str:
    if estado == 1:
        return trc("mision.ya_en_curso", [tr(lista_misiones[actual].titulo)])
    i = n - 1
    if i < 0 or i >= len(lista_misiones):
        return trc("mision.no_existe", [str(n), str(len(lista_misiones))])
    if i > completadas:
        return trc("mision.bloqueada_msg", [str(completadas + 1)])
    mision_preparar(i)
    actual = i
    estado = 1
    transcurrido_s = 0
    racha_s = 0
    motivo_fin = ""
    ultimo_s = tiempo_pared_unix_s()
    return trc("mision.iniciada", [str(n), tr(lista_misiones[i].titulo), tr(lista_misiones[i].briefing), trc("mision.limite", [str(lista_misiones[i].limite_s)])])

fn mision_info() -> str:
    if actual < 0:
        return trc("mision.sin_mision", [tr("cmd.misiones"), tr("cmd.iniciar")])
    m = lista_misiones[actual]
    cabecera = trc("mision.cabecera", [str(actual + 1), tr(m.titulo)])
    if estado == 1:
        return cabecera + "\n" + trc("mision.curso", [str(mision_restante_s()), str(m.limite_s)]) + "\n" + trc("mision.objetivo", [tr(m.briefing)])
    if estado == 2:
        return cabecera + "\n" + trc("mision.completada", [str(puntos)])
    return cabecera + "\n" + trc("mision.fallida", [tr(motivo_fin)])

fn mision_listar() -> str:
    mut partes: List[str] = []
    for i in 0..len(lista_misiones):
        k = mision_estado_de(i)
        mut e = tr("mision.estado.bloqueada")
        if k == 1:
            e = tr("mision.estado.disponible")
        elif k == 2:
            e = tr("mision.estado.en_curso")
        elif k == 3:
            e = tr("mision.estado.completada")
        elif k == 4:
            e = tr("mision.estado.fallida")
        partes.append(trc("mision.linea", [str(i + 1), tr(lista_misiones[i].titulo), e, str(lista_misiones[i].limite_s)]))
    return texto_unir(partes, "\n")

# ---------- serialización ----------

fn mis_num(v: int) -> JsonValor:
    return json_nuevo_numero(float(v))

fn mision_a_json() -> str:
    claves: List[str] = ["estado", "actual", "completadas", "transcurrido_s", "racha_s", "motivo_fin", "puntos", "ultimo"]
    valores: List[JsonValor] = [mis_num(estado), mis_num(actual), mis_num(completadas), mis_num(transcurrido_s), mis_num(racha_s), json_nuevo_cadena(motivo_fin), mis_num(puntos), mis_num(ultimo_s)]
    return json_serializar(json_nuevo_objeto(claves, valores))

# Restaura el estado de misiones desde el texto de mision_a_json. "" si va bien; si no, un mensaje.
# El reloj se reinicia: resto_ms = 0 y ultimo_ms = ahora. La nave se carga aparte con sim_desde_json.
fn mision_desde_json(texto: str) -> str:
    raiz = json_parsear(texto)
    if json_es_error(raiz):
        return trc("mis.err_json", [json_texto(raiz)])
    if json_tipo(raiz) != "objeto":
        return trc("mis.err_forma", ["mision"])
    numeros = ["estado", "actual", "completadas", "transcurrido_s", "racha_s", "puntos"]
    for k in 0..len(numeros):
        if json_tipo(json_obtener(raiz, numeros[k])) != "numero":
            return trc("mis.err_forma", [numeros[k]])
    if json_tipo(json_obtener(raiz, "motivo_fin")) != "cadena":
        return trc("mis.err_forma", ["motivo_fin"])
    n_estado = int(json_numero(json_obtener(raiz, "estado")))
    n_actual = int(json_numero(json_obtener(raiz, "actual")))
    n_completadas = int(json_numero(json_obtener(raiz, "completadas")))
    n_transcurrido = int(json_numero(json_obtener(raiz, "transcurrido_s")))
    n_racha = int(json_numero(json_obtener(raiz, "racha_s")))
    n_puntos = int(json_numero(json_obtener(raiz, "puntos")))
    if n_estado < 0 or n_estado > 3:
        return trc("mis.err_rango", ["estado"])
    if n_actual < -1 or n_actual >= len(lista_misiones):
        return trc("mis.err_rango", ["actual"])
    if n_completadas < 0 or n_completadas > len(lista_misiones):
        return trc("mis.err_rango", ["completadas"])
    if n_estado != 0 and n_actual < 0:
        return trc("mis.err_rango", ["actual"])
    if n_transcurrido < 0 or n_racha < 0:
        return trc("mis.err_rango", ["transcurrido_s"])
    estado = n_estado
    actual = n_actual
    completadas = n_completadas
    transcurrido_s = n_transcurrido
    racha_s = n_racha
    motivo_fin = json_texto(json_obtener(raiz, "motivo_fin"))
    puntos = n_puntos
    ultimo_s = tiempo_pared_unix_s()
    if json_tipo(json_obtener(raiz, "ultimo")) == "numero":
        ultimo_s = int(json_numero(json_obtener(raiz, "ultimo")))
    return ""

# Misiones completadas en total (cuenta de la partida). main.lg compara antes y después de cada petición.
fn misiones_completadas_total() -> int:
    return completadas

# Puntos de la última misión completada.
fn mision_puntos_final() -> int:
    return puntos
