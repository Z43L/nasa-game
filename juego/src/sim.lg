import i18n
import json

# src/sim.lg: modelo de la nave y su simulación. Cada segundo de misión llama a sim_paso().
#
# Sistemas: reactor (temperatura), refrigeracion (potencia %), energia (carga %),
# oxigeno (presión kPa), comunicaciones (señal %), co2 (concentración) e hidrogeno.
# Un sistema puede:
#   - estar apagado (activo = false),
#   - tener una avería (averia distinto de ""): su valor cambia cada segundo según `deriva`
#     (deriva positiva: sube; negativa: baja). Sin avería, co2 vuelve hacia su objetivo.
#   - salirse de su rango seguro [minimo, maximo].
# Los sistemas se acoplan: sin refrigeración sana el reactor se calienta; sin reactor sano no hay recarga.
#
# Serialización (lib/datos/json.lg):
#   sim_a_json() -> str                      {"sistemas": [ {nombre, valor, objetivo, minimo, maximo, activo, averia, deriva, diagnosticado}, ... ]}
#   sim_desde_json(texto: str) -> str        "" si va bien; si no, un mensaje de error (clave mis.*)

struct Sistema:
    nombre: str
    valor: int
    objetivo: int
    minimo: int
    maximo: int
    activo: bool
    averia: str
    deriva: int
    diagnosticado: bool

fn sim_nueva_nave() -> List[Sistema]:
    mut l: List[Sistema] = []
    l.append(Sistema(nombre: "reactor", valor: 450, objetivo: 450, minimo: 300, maximo: 650, activo: true, averia: "", deriva: 0, diagnosticado: false))
    l.append(Sistema(nombre: "refrigeracion", valor: 80, objetivo: 80, minimo: 0, maximo: 100, activo: true, averia: "", deriva: 0, diagnosticado: false))
    l.append(Sistema(nombre: "energia", valor: 80, objetivo: 80, minimo: 0, maximo: 100, activo: true, averia: "", deriva: 0, diagnosticado: false))
    l.append(Sistema(nombre: "oxigeno", valor: 101, objetivo: 101, minimo: 95, maximo: 110, activo: true, averia: "", deriva: 0, diagnosticado: false))
    l.append(Sistema(nombre: "comunicaciones", valor: 90, objetivo: 90, minimo: 60, maximo: 100, activo: true, averia: "", deriva: 0, diagnosticado: false))
    l.append(Sistema(nombre: "co2", valor: 3, objetivo: 3, minimo: 0, maximo: 8, activo: true, averia: "", deriva: 0, diagnosticado: false))
    l.append(Sistema(nombre: "hidrogeno", valor: 70, objetivo: 70, minimo: 20, maximo: 100, activo: true, averia: "", deriva: 0, diagnosticado: false))
    return l

mut sistemas: List[Sistema] = sim_nueva_nave()

# Devuelve el sistema con ese nombre (el primero si no existe: usa sim_existe antes).
fn sim_existe(nombre: str) -> bool:
    for i in 0..len(sistemas):
        if sistemas[i].nombre == nombre:
            return true
    return false

fn sim_s(nombre: str) -> Sistema:
    for i in 0..len(sistemas):
        if sistemas[i].nombre == nombre:
            return sistemas[i]
    return sistemas[0]

fn sim_acotar(v: int, lo: int, hi: int) -> int:
    if v < lo:
        return lo
    if v > hi:
        return hi
    return v

# Acerca v a objetivo en pasos de `paso`, sin pasarse.
fn sim_acercar(v: int, objetivo: int, paso: int) -> int:
    if v < objetivo:
        return sim_acotar(v + paso, v, objetivo)
    if v > objetivo:
        return sim_acotar(v - paso, objetivo, v)
    return v

fn sim_sano(s: Sistema) -> bool:
    return s.activo and s.averia == "" and s.valor >= s.minimo and s.valor <= s.maximo

fn sim_todos_sanos() -> bool:
    for i in 0..len(sistemas):
        if not sim_sano(sistemas[i]):
            return false
    return true

# 0 OK, 1 avería, 2 apagado, 3 fuera de rango.
fn sim_estado_id(s: Sistema) -> int:
    if not s.activo:
        return 2
    if s.averia != "":
        return 1
    if s.valor < s.minimo or s.valor > s.maximo:
        return 3
    return 0

fn sim_estado(s: Sistema) -> str:
    id = sim_estado_id(s)
    if id == 0:
        return tr("estado.ok")
    if id == 1:
        return trc("estado.averia", [tr(s.averia)])
    if id == 2:
        return tr("estado.apagado")
    return tr("estado.fuera")

# Nombre traducido de un sistema.
fn sim_nombre(s: Sistema) -> str:
    return tr("sys." + s.nombre)

# Inyecta una avería (la usan las misiones al empezar).
fn sim_averiar(nombre: str, motivo: str, deriva: int):
    mut s = sim_s(nombre)
    s.averia = motivo
    s.deriva = deriva

# Un segundo de simulación.
fn sim_paso():
    mut rea = sim_s("reactor")
    mut ref = sim_s("refrigeracion")
    mut ene = sim_s("energia")
    mut oxi = sim_s("oxigeno")
    mut com = sim_s("comunicaciones")
    mut co2 = sim_s("co2")
    # Refrigeración: regula su potencia hacia el objetivo mientras está sana.
    if ref.activo and ref.averia == "":
        ref.valor = sim_acercar(ref.valor, ref.objetivo, 5)
    # Reactor: calor natural; la refrigeración sana lo enfría según su potencia.
    if rea.activo:
        rea.valor = rea.valor + 3
    if ref.activo and ref.averia == "":
        rea.valor = rea.valor - ref.valor / 8
    # Oxígeno: vuelve a su presión nominal mientras está sano.
    if oxi.activo and oxi.averia == "":
        oxi.valor = sim_acercar(oxi.valor, oxi.objetivo, 2)
    # Comunicaciones: recupera la señal mientras está sana.
    if com.activo and com.averia == "":
        com.valor = sim_acercar(com.valor, com.objetivo, 2)
    # CO2: sin avería se regula hacia su objetivo (1 por segundo).
    if co2.activo and co2.averia == "":
        co2.valor = sim_acercar(co2.valor, co2.objetivo, 1)
    # Energía: cada sistema activo consume 1; el reactor sano recarga 3.
    mut consumo = 0
    if ref.activo:
        consumo = consumo + 1
    if oxi.activo:
        consumo = consumo + 1
    if com.activo:
        consumo = consumo + 1
    mut recarga = 0
    if rea.activo and rea.averia == "":
        recarga = 3
    ene.valor = sim_acotar(ene.valor + recarga - consumo, 0, 100)
    # Sin energía suficiente, las comunicaciones pierden señal.
    if com.activo and ene.valor < 10:
        com.valor = sim_acotar(com.valor - 5, 0, 100)
    # Avería: cada sistema averiado deriva según su valor de deriva (el CO2 sube si su deriva es positiva).
    for i in 0..len(sistemas):
        mut s = sistemas[i]
        if s.averia != "":
            s.valor = s.valor + s.deriva

# Estado inicial de la nave (al empezar cada misión).
fn sim_reiniciar():
    sistemas = sim_nueva_nave()

# Sustituye la lista completa de sistemas (la usa sim_desde_json; solo lo modifica este módulo).
fn sim_cargar_lista(nueva: List[Sistema]):
    sistemas = nueva

# Todos los sistemas, para recorrerlos desde otros módulos (aplicaciones y terminal).
fn sim_lista() -> List[Sistema]:
    return sistemas

# Sistemas que consumen energía cuando están activos.
fn sim_consumo() -> int:
    mut n = 0
    consumidores = ["refrigeracion", "oxigeno", "comunicaciones"]
    for i in 0..len(consumidores):
        if sim_s(consumidores[i]).activo:
            n = n + 1
    return n

# Recarga de la batería: solo con el reactor sano.
fn sim_recarga() -> int:
    rea = sim_s("reactor")
    if rea.activo and rea.averia == "":
        return 3
    return 0

# ---------- serialización ----------

fn sim_sistema_a_valor(s: Sistema) -> JsonValor:
    # Sin minimo/maximo: son constantes del modelo (sim_base_de) y así el estado cabe en la cookie.
    claves: List[str] = ["nombre", "valor", "objetivo", "activo", "averia", "deriva", "diagnosticado"]
    valores: List[JsonValor] = [json_nuevo_cadena(s.nombre), json_nuevo_numero(float(s.valor)), json_nuevo_numero(float(s.objetivo)), json_nuevo_bool(s.activo), json_nuevo_cadena(s.averia), json_nuevo_numero(float(s.deriva)), json_nuevo_bool(s.diagnosticado)]
    return json_nuevo_objeto(claves, valores)

fn sim_a_json() -> str:
    mut elementos: List[JsonValor] = []
    for i in 0..len(sistemas):
        elementos.append(sim_sistema_a_valor(sistemas[i]))
    claves: List[str] = ["sistemas"]
    valores: List[JsonValor] = [json_nuevo_lista(elementos)]
    return json_serializar(json_nuevo_objeto(claves, valores))

# "" si e es un sistema con todos sus campos del tipo correcto; si no, el nombre del campo que falla.
fn sim_campo_malo(e: JsonValor) -> str:
    if json_tipo(e) != "objeto":
        return "sistema"
    cadenas = ["nombre", "averia"]
    for i in 0..len(cadenas):
        if json_tipo(json_obtener(e, cadenas[i])) != "cadena":
            return cadenas[i]
    numeros = ["valor", "objetivo", "deriva"]
    for i in 0..len(numeros):
        if json_tipo(json_obtener(e, numeros[i])) != "numero":
            return numeros[i]
    booleanos = ["activo", "diagnosticado"]
    for i in 0..len(booleanos):
        if json_tipo(json_obtener(e, booleanos[i])) != "bool":
            return booleanos[i]
    return ""

fn sim_en_lista(l: List[Sistema], nombre: str) -> bool:
    for i in 0..len(l):
        if l[i].nombre == nombre:
            return true
    return false

# Carga la nave desde el texto de sim_a_json. "" si va bien; si no, un mensaje traducido.
# Definición base de un sistema (rangos fijos del modelo).
fn sim_base_de(nombre: str) -> Sistema:
    base = sim_nueva_nave()
    for i in 0..len(base):
        if base[i].nombre == nombre:
            return base[i]
    return base[0]

fn sim_desde_json(texto: str) -> str:
    raiz = json_parsear(texto)
    if json_es_error(raiz):
        return trc("mis.err_json", [json_texto(raiz)])
    if json_tipo(raiz) != "objeto":
        return trc("mis.err_forma", ["sistemas"])
    lista = json_obtener(raiz, "sistemas")
    if json_tipo(lista) != "lista":
        return trc("mis.err_forma", ["sistemas"])
    n = json_longitud(lista)
    if n != len(sistemas):
        return trc("mis.err_faltan", [str(len(sistemas))])
    mut nueva: List[Sistema] = []
    for i in 0..n:
        e = json_elemento(lista, i)
        malo = sim_campo_malo(e)
        if malo != "":
            return trc("mis.err_forma", [malo])
        nombre = json_texto(json_obtener(e, "nombre"))
        if not sim_existe(nombre) or sim_en_lista(nueva, nombre):
            return trc("mis.err_sistema", [nombre])
        base = sim_base_de(nombre)
        nueva.append(Sistema(nombre: nombre, valor: int(json_numero(json_obtener(e, "valor"))), objetivo: int(json_numero(json_obtener(e, "objetivo"))), minimo: base.minimo, maximo: base.maximo, activo: json_booleano(json_obtener(e, "activo")), averia: json_texto(json_obtener(e, "averia")), deriva: int(json_numero(json_obtener(e, "deriva"))), diagnosticado: json_booleano(json_obtener(e, "diagnosticado"))))
    sim_cargar_lista(nueva)
    return ""
