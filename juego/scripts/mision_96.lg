# scripts/mision_96.lg: repara reactor y refrigeracion; si el reactor pasa de 480, sube la refrigeracion al maximo.
import nave

sistemas = ["reactor", "refrigeracion"]
mut ciclos = 0
while ciclos < 40:
    for i in 0..len(sistemas):
        nave_diagnostico(sistemas[i])
        print(nave_reparar(sistemas[i]))
    if nave_valor("reactor") > 480:
        print(nave_ajustar("refrigeracion", 100))
    nave_esperar(1)
    ciclos = ciclos + 1
print("vigilancia terminada")
