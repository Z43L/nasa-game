import nave
import texto

# Vigila la señal y el reactor: repara averías y sube el objetivo de comunicaciones si la señal baja de 85.
fn vigilar(sistema: str):
    e = nave_estado(sistema)
    if texto_contiene(e, "AVERIA"):
        nave_diagnostico(sistema)
        nave_reparar(sistema)

mut ciclos = 0
while ciclos < 50:
    vigilar("comunicaciones")
    vigilar("reactor")
    if nave_valor("comunicaciones") < 85:
        nave_ajustar("comunicaciones", 100)
    nave_esperar(1)
    ciclos = ciclos + 1
print("señal vigilada")
