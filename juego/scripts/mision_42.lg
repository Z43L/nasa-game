import nave

# Mision 42: diagnostica y repara oxigeno e hidrogeno cada segundo.
mut sistemas: List[str] = ["oxigeno", "hidrogeno"]
mut ciclos = 0
while ciclos < 40:
    for i in 0..len(sistemas):
        nave_diagnostico(sistemas[i])
        nave_reparar(sistemas[i])
    nave_esperar(1)
    ciclos = ciclos + 1
print("vigilancia terminada")
