# lib/datos/json.lg: JSON (RFC 8259) en el lenguaje: parser a un valor tipado y serializador canónico.
#
# MODELO DE VALOR
#   struct JsonValor con el campo etiqueta: int, que indica el tipo, y los campos de cada tipo:
#     etiqueta 0  nulo
#     etiqueta 1  bool       booleano
#     etiqueta 2  número     numero (float)
#     etiqueta 3  cadena     texto
#     etiqueta 4  lista      elementos (List[JsonValor])
#     etiqueta 5  objeto     claves (List[str]) y valores (List[JsonValor]), en paralelo, en orden de aparición
#     etiqueta 6  error      texto = mensaje con la posición, p. ej. "posición 3: se esperaba ':'"
#   Los campos que no corresponden a la etiqueta valen cero ("", 0.0, false, listas vacías).
#   Sin genéricos ni tipos suma, la etiqueta es el discriminante. Un error es un valor más:
#   una entrada inválida nunca provoca panic.
#
# API
#   json_parsear(texto: str) -> JsonValor                  valor, o etiqueta 6 si el texto no es JSON válido
#   json_es_valido(texto: str) -> bool
#   json_es_error(v: JsonValor) -> bool
#   json_tipo(v: JsonValor) -> str                         "nulo", "bool", "numero", "cadena", "lista", "objeto" o "error"
#   json_serializar(v: JsonValor) -> str                   texto canónico: sin espacios, claves en orden de aparición
#   json_obtener(v: JsonValor, clave: str) -> JsonValor    valor de la clave (la última si se repite); error si falta
#   json_elemento(v: JsonValor, i: int) -> JsonValor       elemento i de una lista; error si no existe
#   json_longitud(v: JsonValor) -> int                     elementos de una lista o claves de un objeto; 0 si no
#   json_texto(v: JsonValor) -> str                        texto de una cadena (o mensaje de un error); "" si no
#   json_numero(v: JsonValor) -> float                     valor de un número; 0.0 si no
#   json_booleano(v: JsonValor) -> bool                    valor de un bool; false si no
#   json_nuevo_nulo(), json_nuevo_bool(b: bool), json_nuevo_numero(x: float), json_nuevo_cadena(s: str),
#   json_nuevo_lista(elementos: List[JsonValor]), json_nuevo_objeto(claves: List[str], valores: List[JsonValor]),
#   json_nuevo_error(mensaje: str)                         constructores para armar valores en el programa.
#
# LÍMITES Y DECISIONES
#   - Entrada: máximo 1 MiB (1048576 bytes). Más grande produce error.
#   - Anidamiento de listas y objetos: máximo 64 niveles. El nivel 65 produce error.
#   - Números: se convierten con float() (doble precisión). Un número fuera del rango de double es error.
#     Los enteros mayores de 2^53 pierden precisión.
#   - Números en la salida: forma de str(float) del lenguaje. 3 se escribe 3.0 y 1e-7 se escribe 1e-07.
#     Un round-trip es exacto si la entrada ya está en esa forma canónica.
#   - Escapes de entrada: \" \\ \/ \b \f \n \r \t y \uXXXX.
#     \uXXXX llega hasta U+07FF (ASCII, latino, griego, cirílico, árabe, ...). Por encima, los pares
#     sustitutos y \u0000 son error: el lenguaje no puede construir bytes de 3 o 4 bytes UTF-8 ni el byte NUL.
#   - Dentro de una cadena, un carácter de control (0x01 a 0x1F) sin escapar es error. Los caracteres UTF-8
#     no ASCII se copian tal cual.
#   - Salida de cadenas: \" \\ \n \r \t, y el resto de controles como \u00XX. Los caracteres UTF-8 no se escapan.
#   - json_serializar de un error devuelve "" (no es JSON).
#
# IMPLEMENTACIÓN
#   Descenso recursivo sobre posiciones de bytes. Los caracteres se leen con recortar() de cadena.lg.
#   Las tablas de bytes son funciones que devuelven literales, porque el lenguaje no tiene chr ni ord
#   y las variables globales no son visibles desde funciones. La unión de partes es por mitades (O(n log n)).
#   No usa nativos propios.
#
# Uso: import json

import cadena

struct JsonValor:
    etiqueta: int
    booleano: bool
    numero: float
    texto: str
    elementos: List[JsonValor]
    claves: List[str]
    valores: List[JsonValor]

struct JsonPaso:
    valor: JsonValor
    siguiente: int

# Constructores

fn json_nuevo_nulo() -> JsonValor:
    return JsonValor(etiqueta: 0, booleano: false, numero: 0.0, texto: "", elementos: [], claves: [], valores: [])

fn json_nuevo_bool(b: bool) -> JsonValor:
    return JsonValor(etiqueta: 1, booleano: b, numero: 0.0, texto: "", elementos: [], claves: [], valores: [])

fn json_nuevo_numero(x: float) -> JsonValor:
    return JsonValor(etiqueta: 2, booleano: false, numero: x, texto: "", elementos: [], claves: [], valores: [])

fn json_nuevo_cadena(s: str) -> JsonValor:
    return JsonValor(etiqueta: 3, booleano: false, numero: 0.0, texto: s, elementos: [], claves: [], valores: [])

fn json_nuevo_lista(elementos: List[JsonValor]) -> JsonValor:
    return JsonValor(etiqueta: 4, booleano: false, numero: 0.0, texto: "", elementos: elementos, claves: [], valores: [])

fn json_nuevo_objeto(claves: List[str], valores: List[JsonValor]) -> JsonValor:
    return JsonValor(etiqueta: 5, booleano: false, numero: 0.0, texto: "", elementos: [], claves: claves, valores: valores)

fn json_nuevo_error(mensaje: str) -> JsonValor:
    return JsonValor(etiqueta: 6, booleano: false, numero: 0.0, texto: mensaje, elementos: [], claves: [], valores: [])

# Tablas de bytes. Son funciones porque el lenguaje no deja usar globales dentro de funciones.

# Bytes 0x01 a 0x7F. El byte de código c está en la posición c - 1.
fn json_tabla_ascii() -> str:
    return "\t\n\r !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

