# stdlib/mat.lg: álgebra básica sobre tensores de forma concreta. Escrito en el lenguaje, sin nativos.
#
# Funciones (cada una fija su forma en la firma):
#   identidad2() -> Tensor[float, (2, 2)]     matriz identidad 2x2
#   identidad3() -> Tensor[float, (3, 3)]     matriz identidad 3x3
#   suma_total(t: Tensor[float, (2, 2)]) -> float
#   media(t: Tensor[float, (2, 2)]) -> float   suma_total(t) / 4
#   producto_punto(a: Tensor[float, (3,)], b: Tensor[float, (3,)]) -> float
#
# LIMITACIÓN: sin genéricos ni dimensiones dinámicas en firmas, no se puede escribir
# identidad(n) ni producto_punto(a, b) para (n) arbitrario. Hay una función por forma.
#
# Uso: import mat

fn identidad2() -> Tensor[float, (2, 2)]:
    mut t: Tensor[float, (2, 2)] = zeros(2, 2)
    for i in 0..2:
        t[i, i] = 1.0
    return t

fn identidad3() -> Tensor[float, (3, 3)]:
    mut t: Tensor[float, (3, 3)] = zeros(3, 3)
    for i in 0..3:
        t[i, i] = 1.0
    return t

fn suma_total(t: Tensor[float, (2, 2)]) -> float:
    mut s = 0.0
    for i in 0..2:
        for j in 0..2:
            s = s + t[i, j]
    return s

fn media(t: Tensor[float, (2, 2)]) -> float:
    return suma_total(t) / 4.0

fn producto_punto(a: Tensor[float, (3,)], b: Tensor[float, (3,)]) -> float:
    mut s = 0.0
    for i in 0..3:
        s = s + a[i] * b[i]
    return s
