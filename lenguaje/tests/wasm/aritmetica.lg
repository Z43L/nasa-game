fn factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

print(7 + 3 * 2)
print(17 / 5)
print(17 % 5)
print(factorial(10))
x = 1.5 * 2.0
print(x)
print(float(3) / 2.0)
print(int(7.9))
