# Búsqueda y recorte en los bordes: cadena vacía, aguja más larga, índices negativos y mayores que la longitud.
import cadena
print(buscar("", ""))
print(buscar("", "a"))
print(buscar("abc", ""))
print(buscar("abc", "abcd"))
print(buscar("abcabc", "abc"))
print(buscar("hola mundo", "mundo"))
print(buscar("abc", "c"))
print(buscar("abc", "x"))
print("[" + recortar("abc", 0, 3) + "]")
print("[" + recortar("abc", 3, 3) + "]")
print("[" + recortar("abc", -5, 2) + "]")
print("[" + recortar("abc", 1, 100) + "]")
print("[" + recortar("abc", 2, 1) + "]")
print("[" + recortar("abc", -10, -1) + "]")
print("[" + recortar("abc", 100, 200) + "]")
print("[" + recortar("", 0, 5) + "]")
print("[" + recortar("hola mundo", 5, 10) + "]")
