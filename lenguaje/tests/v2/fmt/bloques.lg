fn clasifica(n:int)->str:
  if n<0:
     return "negativo"
  elif n == 0:
      return "cero"
  elif n<10:
    return "pequeno"
  else:
    if n<100:
       return "mediano"
    else:
       return "grande"

fn cuenta(n: int) -> int:
  mut i = 0
  while i < n:
    i = i + 1
    if i == 3:
      continue
    if i > 7:
      break

    print(i)
  return i
