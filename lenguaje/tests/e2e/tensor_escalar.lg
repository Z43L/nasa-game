t = from_list([1.0, 2.0, 4.0, 8.0], 4)
a = 2.0 * t
b = t * 2.0
c = 10.0 - t
d = t - 1.0
e = t / 2.0
f = 8.0 / t
print(a[3])
print(b[0])
print(c[0])
print(d[2])
print(e[0])
print(f[3])
print(a.forma())
v = from_list([1, 2, 3], 3)
x = v * 3
y = 10 - v
z = v + 1
w = 12 / v
q = v / 2
print(x[2])
print(y[0])
print(z[1])
print(w[2])
print(q[2])
