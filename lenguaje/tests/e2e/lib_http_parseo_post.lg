import lib_http_mod/http

p = http_parsear_peticion("POST /datos HTTP/1.0\r\nContent-Type: application/json\r\nContent-Length: 8\r\n\r\n{\"a\": 1}XYZ")
print(p.valida, p.metodo, p.version)
print(p.longitud)
print(p.cuerpo)
print(http_cabecera(p, "content-type").desempacar_o("-"))

q = http_parsear_peticion("POST / HTTP/1.1\r\nContent-Length: 0\r\n\r\n")
print(q.valida, q.longitud, q.cuerpo == "")
